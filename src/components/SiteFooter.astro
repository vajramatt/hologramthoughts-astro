---
const year = new Date().getFullYear();
const links = [
  { href: '/archive/', label: 'archive' },
  { href: '/themes/', label: 'threads' },
  { href: '/random/', label: 'random post' },
  { href: '/how/', label: "how it's made" },
  { href: '/rss.xml', label: 'rss' },
  { href: '/llms.txt', label: 'for agents' },
];
---
<footer class="site-footer">
  <div class="mx-auto max-w-6xl px-5 sm:px-6">
    <div class="footer-row">
      <p class="sig">
        <span class="wordmark">hologram thoughts</span>
        <span class="by">© {year} Matthew Williamson · written and grown over twenty years</span>
      </p>
      <nav aria-label="Footer">
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    </div>
    <p class="eot">// end of transmission</p>
  </div>
</footer>

<style>
  .site-footer { margin-top: var(--space-2xl); padding: var(--space-l) 0 var(--space-m); border-top: 1px solid var(--color-border); }
  .footer-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--space-s) var(--space-l); }
  .sig { display: flex; flex-direction: column; gap: 0.35rem; margin: 0; }
  .sig .wordmark { font-size: 0.95rem; width: fit-content; }
  .by { color: var(--color-ink-faint); font: var(--step--1) var(--font-ui); }
  nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  nav a { display: inline-flex; align-items: center; min-height: 36px; color: var(--color-ink-soft); font: var(--step--1) var(--font-ui); text-decoration: none; }
  nav a:hover { color: var(--color-cyan); }
  .eot { margin: var(--space-m) 0 0; color: var(--color-ink-faint); font: 11px var(--font-mono); letter-spacing: 0.14em; opacity: 0.7; }
</style>
