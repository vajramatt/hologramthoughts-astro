---
import ThemeChip from './ThemeChip.astro';
import { themeById } from '../utils/posts';

interface Props { themeIds: string[]; label?: string; }
const { themeIds, label = 'threads in this post' } = Astro.props;
const themes = themeIds.map((id) => themeById.get(id)).filter(Boolean);
---
{themes.length > 0 && (
  <aside class="theme-strip" aria-label="Threads in this post">
    <div class="section-label"><p>{label}</p><p>tap a thread to follow it</p></div>
    <div class="chips">
      {themes.map((t) => <ThemeChip id={t!.id} name={t!.name} />)}
    </div>
  </aside>
)}

<style>
  .theme-strip { margin-top: var(--space-l); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
</style>
