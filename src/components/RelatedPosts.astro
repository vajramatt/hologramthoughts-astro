---
import { getCollection } from 'astro:content';
import type { RelatedPost } from '../lib/themes';

interface Props { related: RelatedPost[]; }
const { related } = Astro.props;

const all = await getCollection('blog', ({ data }) => !data.draft);
// Build multi-key index: frontmatter slug, astro slug, and id (with/without .md)
// to tolerate any of those being how related[].slug was generated.
const bySlug = new Map();
for (const p of all) {
  const idBase = p.id.replace(/\.md$/, '');
  if (p.data.slug) bySlug.set(p.data.slug, p);
  if ((p as any).slug) bySlug.set((p as any).slug, p);
  bySlug.set(idBase, p);
}
const items = related
  .map(r => ({ post: bySlug.get(r.slug), rationale: r.rationale, slug: r.slug }))
  .filter(x => x.post);
---
{items.length > 0 && (
  <aside class="related">
    <div class="related-heading">
      <span>READ NEXT</span>
      <p>If this stayed with you</p>
    </div>
    <ul>
      {items.map(({ post, rationale }) => (
        <li>
          <a href={`/blog/${(post as any).slug ?? post!.id.replace(/\.md$/, '')}/`}>
            <small>{new Date(post!.data.pubDate).getUTCFullYear()} / related post</small>
            <strong>{post!.data.title}</strong>
            <p>{rationale}</p>
            <span aria-hidden="true">Read post →</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .related { margin-top: 3.5rem; }
  .related-heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    margin-bottom: 1rem;
  }
  .related-heading > span {
    color: var(--color-magenta);
    font: 500 0.65rem/1 var(--font-mono);
    letter-spacing: 0.12em;
  }
  .related-heading p {
    color: var(--color-ink-soft);
    font: italic 0.9rem/1.4 var(--font-display);
  }
  .related-heading abbr { text-decoration: none; border-bottom: 1px dotted var(--color-border-strong); cursor: help; }
  .related ul {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }
  .related li { display: flex; }
  .related a {
    display: flex;
    width: 100%;
    min-height: 12rem;
    flex-direction: column;
    padding: 1.15rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: color-mix(in oklch, var(--color-surface) 45%, transparent);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast), background var(--dur-fast), transform var(--dur-fast);
  }
  .related a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--color-cyan) 50%, transparent);
    background: color-mix(in oklch, var(--color-blue) 7%, var(--color-surface));
  }
  .related small {
    color: var(--color-ink-faint);
    font: 0.59rem/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .related strong {
    margin-top: 0.7rem;
    font: 450 1.15rem/1.18 var(--font-display);
  }
  .related p {
    margin-top: 0.55rem;
    color: var(--color-ink-soft);
    font: italic 0.8rem/1.45 var(--font-display);
  }
  .related a > span {
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-cyan);
    font: 0.63rem/1 var(--font-mono);
  }
  @media (max-width: 540px) {
    .related-heading { display: block; }
    .related-heading p { margin-top: 0.5rem; }
    .related ul { grid-template-columns: 1fr; }
    .related a { min-height: 10rem; }
  }
</style>
