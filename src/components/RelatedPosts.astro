---
// "Read next" — series continuation (if any) as a lead card, then the three
// related posts with their rationale. Grid never leaves an orphaned card.
import type { RelatedPost } from '../lib/themes';
import { publishedPosts, slugIndex, urlOf } from '../utils/posts';
import { CONTENT_TYPE_LABEL, type ContentType } from '../utils/categories';

interface Props {
  related: RelatedPost[];
  seriesNext?: { title: string; url: string; order: number; total: number; series: string } | null;
}
const { related, seriesNext = null } = Astro.props;

const bySlug = slugIndex(await publishedPosts());
const items = related
  .map((r) => ({ post: bySlug.get(r.slug), rationale: r.rationale }))
  .filter((x) => x.post)
  .slice(0, 3);
const n = items.length;
---
{(n > 0 || seriesNext) && (
  <section class="read-next" aria-labelledby="read-next-title">
    <div class="section-label">
      <h2 id="read-next-title">read next</h2>
      <p>if this stayed with you</p>
    </div>

    {seriesNext && (
      <a class="series-next" href={seriesNext.url}>
        <span class="sn-kicker">Continue · {seriesNext.series} · part {seriesNext.order} of {seriesNext.total}</span>
        <strong>{seriesNext.title}</strong>
        <span class="sn-go" aria-hidden="true">next part →</span>
      </a>
    )}

    {n > 0 && (
      <ul class:list={['rn-grid', `n${n}`]}>
        {items.map(({ post, rationale }) => {
          const type = (post!.data.contentType ?? 'reflection') as ContentType;
          return (
            <li>
              <a href={urlOf(post!)}>
                <span class="rn-meta">
                  <span>{post!.data.pubDate.getUTCFullYear()}</span>
                  <span class="rn-type">{CONTENT_TYPE_LABEL[type]}</span>
                </span>
                <strong>{post!.data.title}</strong>
                {rationale && <p>{rationale}</p>}
              </a>
            </li>
          );
        })}
      </ul>
    )}
  </section>
)}

<style>
  .read-next { margin-top: var(--space-xl); }
  .section-label h2 { font-family: var(--font-mono); font-weight: 500; }
  .section-label p { font: italic var(--step--1)/1.3 var(--font-display) !important; color: var(--color-ink-soft) !important; }

  .series-next {
    display: grid;
    gap: 0.4rem;
    margin-bottom: var(--space-s);
    padding: var(--space-m);
    border: 1px solid color-mix(in oklch, var(--color-green) 35%, var(--color-border));
    border-radius: var(--radius-m);
    background:
      linear-gradient(120deg, color-mix(in oklch, var(--color-green) 9%, transparent), transparent 55%),
      var(--tile-bg);
    box-shadow: var(--shadow-1);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast), transform var(--dur-fast) var(--ease-grow);
  }
  .series-next:hover { border-color: var(--color-green); transform: translateY(-2px); }
  .sn-kicker { color: var(--color-green); font: var(--step--2)/1.3 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; }
  .series-next strong { font: 480 var(--step-3)/1.1 var(--font-display); text-wrap: balance; }
  .sn-go { color: var(--color-cyan); font: var(--step--2) var(--font-mono); }

  .rn-grid {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rn-grid.n3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .rn-grid.n2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rn-grid.n1 { grid-template-columns: 1fr; }
  li { display: flex; }
  .rn-grid a {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    padding: var(--space-s) var(--space-s) var(--space-m);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--tile-bg);
    box-shadow: var(--shadow-1);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast) var(--ease-grow), transform var(--dur-fast) var(--ease-grow);
  }
  .rn-grid a:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklch, var(--color-cyan) 45%, transparent);
    box-shadow: var(--shadow-2);
  }
  .rn-meta { display: flex; justify-content: space-between; color: var(--color-amber-bright); font: var(--step--2)/1 var(--font-mono); }
  .rn-type { color: var(--color-magenta); text-transform: uppercase; letter-spacing: 0.08em; }
  .rn-grid strong { font: 480 var(--step-1)/1.2 var(--font-display); text-wrap: balance; }
  .rn-grid a:hover strong { color: var(--color-cyan); }
  .rn-grid p { margin: 0; color: var(--color-ink-soft); font: italic var(--step--1)/1.5 var(--font-body); }
  @media (max-width: 760px) {
    .rn-grid.n3, .rn-grid.n2 { grid-template-columns: 1fr; }
  }
</style>
