---
interface Props {
  headings: Array<{
    depth: number;
    slug: string;
    text: string;
  }>;
}

const { headings } = Astro.props;
const showTOC = headings && headings.length > 1;
---

{showTOC && (
  <nav class="toc" aria-label="On this page">
    <div class="toc-heading">
      <span aria-hidden="true">§</span>
      <p>On this page</p>
      <small>{headings.length} sections</small>
    </div>
    <ul>
      {headings.map((heading) => (
        <li class={`toc-level-${heading.depth}`}>
          <a href={`#${heading.slug}`}>{heading.text}<span aria-hidden="true">↘</span></a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    margin: 0 0 3rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: linear-gradient(120deg, color-mix(in oklch, var(--color-blue) 7%, transparent), color-mix(in oklch, var(--color-surface) 54%, transparent));
  }
  .toc-heading {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.65rem;
    align-items: center;
    padding-bottom: 0.75rem;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-mono);
  }
  .toc-heading > span { color: var(--color-magenta); }
  .toc-heading p {
    color: var(--color-ink-soft);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .toc-heading small { color: var(--color-ink-faint); font-size: 0.62rem; }
  .toc ul { display: grid; gap: 0.1rem; }
  .toc li { list-style: none; }
  .toc a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.38rem 0.25rem;
    color: var(--color-ink-soft);
    font: 0.85rem/1.4 var(--font-ui);
    text-decoration: none;
  }
  .toc a span { color: var(--color-ink-faint); opacity: 0; transition: opacity var(--dur-fast), transform var(--dur-fast); }
  .toc a:hover { color: var(--color-cyan); }
  .toc a:hover span { opacity: 1; transform: translate(2px, 2px); }
  .toc-level-3 { padding-left: 1rem; }
  .toc-level-4, .toc-level-5, .toc-level-6 { padding-left: 2rem; opacity: 0.85; }
</style>
