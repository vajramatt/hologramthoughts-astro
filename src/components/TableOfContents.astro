---
// Contents for long posts. Two renderings from one list:
//   variant="rail"   — sticky sidebar with active-section highlight (wide screens)
//   variant="inline" — collapsible <details> above the body (narrow screens)
// Rendered only when a post has 3+ h2/h3 headings.
interface Heading { depth: number; slug: string; text: string; }
interface Props { headings: Heading[]; variant: 'rail' | 'inline'; }
const { headings, variant } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const clean = (t: string) => t.replace(/^#\s*/, '').trim();
---
{variant === 'rail' ? (
  <nav class="toc-rail" aria-label="Contents" data-toc>
    <p class="toc-label">contents</p>
    <ol>
      {items.map((h) => (
        <li class={`d${h.depth}`}><a href={`#${h.slug}`} data-toc-link={h.slug}>{clean(h.text)}</a></li>
      ))}
    </ol>
  </nav>
) : (
  <details class="toc-inline">
    <summary><span class="toc-label">contents</span><span class="toc-count">{items.length} sections</span></summary>
    <ol>
      {items.map((h) => (
        <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{clean(h.text)}</a></li>
      ))}
    </ol>
  </details>
)}

<style>
  .toc-label {
    margin: 0;
    color: var(--color-magenta);
    font: 500 var(--step--2)/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .toc-label::before { content: "// "; color: var(--color-ink-faint); }
  ol { margin: 0; padding: 0; list-style: none; }
  a {
    display: block;
    color: var(--color-ink-soft);
    text-decoration: none;
    font: var(--step--1)/1.4 var(--font-ui);
    transition: color var(--dur-fast), border-color var(--dur-fast);
  }
  a:hover { color: var(--color-cyan); }
  .d3 a { padding-left: 0.85rem; font-size: var(--step--2); }

  .toc-rail { position: sticky; top: calc(var(--header-h) + 2rem); max-height: calc(100vh - var(--header-h) - 4rem); overflow-y: auto; scrollbar-width: thin; }
  .toc-rail .toc-label { margin-bottom: var(--space-xs); }
  .toc-rail a {
    padding: 0.32rem 0 0.32rem 0.75rem;
    border-left: 1px solid var(--color-border);
  }
  .toc-rail a:global(.is-active) {
    color: var(--color-ink);
    border-left-color: var(--color-cyan);
    box-shadow: inset 1px 0 0 var(--color-cyan);
  }

  .toc-inline {
    margin: 0 0 var(--space-l);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-m);
    background: var(--tile-bg);
    box-shadow: var(--shadow-1);
  }
  .toc-inline summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 48px;
    padding: 0 1rem;
    cursor: pointer;
    list-style: none;
  }
  .toc-inline summary::-webkit-details-marker { display: none; }
  .toc-inline summary::after { content: "+"; color: var(--color-cyan); font: 1rem var(--font-mono); margin-left: 0.75rem; }
  .toc-inline[open] summary::after { content: "−"; }
  .toc-count { margin-left: auto; color: var(--color-ink-faint); font: var(--step--2) var(--font-mono); }
  .toc-inline ol { padding: 0 1rem 0.9rem; }
  .toc-inline a { padding: 0.4rem 0; border-top: 1px solid var(--color-border); }
</style>
