---
interface Props { reading?: { title: string } | null; }
const { reading = null } = Astro.props;
const nav = [
  { href: '/archive/', label: 'archive' },
  { href: '/themes/', label: 'themes' },
  { href: '/categories/', label: 'categories' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href.replace(/\/$/, ''));
---
<header class="site-header" data-site-header>
  <div class="header-inner mx-auto max-w-6xl px-5 sm:px-6">
    <a href="/" class="brand no-underline shrink-0" aria-label="Hologram Thoughts home">
      <span class="wordmark">hologram thoughts</span><span class="term-caret" aria-hidden="true"></span>
    </a>

    {reading && (
      <p class="reading-title" aria-hidden="true">
        <span class="rt-prompt">~/</span><span class="rt-text">{reading.title}</span>
      </p>
    )}

    <nav class="desktop-nav" aria-label="Primary">
      {nav.map((n) => (
        <a
          href={n.href}
          class:list={['nav-link no-underline', isActive(n.href) && 'active']}
          aria-current={isActive(n.href) ? 'page' : undefined}
        >{n.label}</a>
      ))}
      <a href="/search/" class:list={['nav-link search-trigger no-underline', isActive('/search/') && 'active']} data-palette-open aria-keyshortcuts="Meta+K Control+K /">
        <svg width="14" height="14" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <span>search</span>
        <kbd data-kbd-hint>⌘K</kbd>
      </a>
    </nav>

    <div class="mobile-actions">
      <a href="/search/" class="icon-btn" data-palette-open aria-label="Search the archive">
        <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true"><circle cx="7" cy="7" r="5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M11 11l3.5 3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </a>
      <details class="mobile-menu">
        <summary aria-label="Open navigation">
          <span>menu</span><span class="menu-glyph" aria-hidden="true">+</span>
        </summary>
        <nav class="mobile-panel" aria-label="Mobile navigation">
          <p class="panel-label">// navigate</p>
          {[{ href: '/', label: 'home' }, ...nav, { href: '/search/', label: 'search' }].map((n, index) => (
            <a
              href={n.href}
              class:list={['mobile-link', n.href !== '/' && isActive(n.href) && 'active']}
              aria-current={n.href !== '/' && isActive(n.href) ? 'page' : undefined}
            >
              <span class="link-index">0{index + 1}</span>
              <span>{n.label}</span>
              <span aria-hidden="true">→</span>
            </a>
          ))}
        </nav>
      </details>
    </div>
  </div>

  {reading && (
    <div class="reading-meter" aria-hidden="true">
      <span class="rm-bar" data-rm-bar></span>
      <span class="rm-left" data-rm-left></span>
    </div>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 30;
    border-bottom: 1px solid var(--color-border);
    background:
      linear-gradient(90deg, color-mix(in oklch, var(--color-blue) 4%, transparent), transparent 35%, color-mix(in oklch, var(--color-magenta) 4%, transparent)),
      color-mix(in oklch, var(--color-bg) 90%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
  }
  .header-inner {
    position: relative;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .brand { font-size: 1.05rem; transition: opacity var(--dur-med) var(--ease-grow); }

  .desktop-nav { display: flex; align-items: center; gap: 1.6rem; font-family: var(--font-ui); font-size: 0.9rem; }
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    color: var(--color-ink-soft);
    transition: color var(--dur-fast) var(--ease-grow);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: 6px;
    height: 1px;
    background: linear-gradient(90deg, var(--color-blue), var(--color-cyan));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-fast) var(--ease-grow);
  }
  .nav-link:hover, .nav-link.active { color: var(--color-cyan); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .search-trigger {
    padding: 0 0.3rem 0 0.6rem;
    min-height: 34px;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    background: color-mix(in oklch, var(--color-surface) 50%, transparent);
  }
  .search-trigger::after { display: none; }
  .search-trigger:hover { border-color: color-mix(in oklch, var(--color-cyan) 55%, transparent); }
  .search-trigger kbd {
    border: 1px solid var(--color-border-strong);
    border-radius: 4px;
    padding: 0.1rem 0.3rem;
    color: var(--color-ink-faint);
    font: 0.62rem var(--font-mono);
  }

  /* Reading mode: after the post title scrolls away, the header carries it. */
  .reading-title {
    position: absolute;
    left: 50%;
    top: 50%;
    max-width: min(46ch, 52vw);
    margin: 0;
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
    color: var(--color-ink);
    font: 450 0.98rem/1.2 var(--font-display);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transform: translate(-50%, calc(-50% + 6px));
    transition: opacity var(--dur-med) var(--ease-grow), transform var(--dur-med) var(--ease-grow);
  }
  .rt-prompt { color: var(--color-green); font: 0.72rem var(--font-mono); }
  .rt-text { overflow: hidden; text-overflow: ellipsis; }
  :global(.site-header.is-reading) .reading-title { opacity: 1; transform: translate(-50%, -50%); }
  :global(.site-header.is-reading) .desktop-nav .nav-link:not(.search-trigger) { opacity: 0; pointer-events: none; }
  .desktop-nav .nav-link { transition: color var(--dur-fast) var(--ease-grow), opacity var(--dur-med) var(--ease-grow); }

  .reading-meter {
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 2px;
    pointer-events: none;
  }
  .rm-bar {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-blue), var(--color-cyan), var(--color-magenta));
    transform: scaleX(var(--progress, 0));
    transform-origin: left;
    box-shadow: 0 0 10px color-mix(in oklch, var(--color-cyan) 45%, transparent);
  }
  .rm-left {
    position: absolute;
    right: max(1.25rem, calc((100vw - 72rem) / 2 + 1.5rem));
    top: 6px;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: color-mix(in oklch, var(--color-bg) 92%, transparent);
    color: var(--color-ink-faint);
    font: 0.62rem/1.3 var(--font-mono);
    opacity: 0;
    transition: opacity var(--dur-med);
  }
  :global(.site-header.is-reading) .rm-left:not(:empty) { opacity: 1; }

  .mobile-actions { display: none; align-items: center; gap: 0.25rem; }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--color-ink-soft);
    border-radius: 8px;
  }
  .icon-btn:hover { color: var(--color-cyan); }
  .mobile-menu { position: relative; }
  .mobile-menu summary {
    min-width: 68px;
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.45rem;
    cursor: pointer;
    list-style: none;
    color: var(--color-cyan);
    font: 0.78rem var(--font-mono);
  }
  .mobile-menu summary::-webkit-details-marker { display: none; }
  .menu-glyph {
    display: inline-grid;
    place-items: center;
    width: 1.2rem;
    height: 1.2rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    transition: transform var(--dur-fast) var(--ease-grow);
  }
  .mobile-menu[open] .menu-glyph { transform: rotate(45deg); }
  .mobile-panel {
    position: fixed;
    top: var(--header-h);
    left: 0;
    right: 0;
    padding: 1rem 1.25rem 1.35rem;
    background:
      radial-gradient(circle at 90% 0%, color-mix(in oklch, var(--color-magenta) 12%, transparent), transparent 42%),
      color-mix(in oklch, var(--color-bg-soft) 97%, transparent);
    border-bottom: 1px solid var(--color-border-strong);
    box-shadow: 0 18px 40px oklch(0 0 0 / 0.42);
  }
  .panel-label {
    margin: 0 0 0.5rem;
    color: var(--color-magenta);
    font: 0.65rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .mobile-link {
    display: grid;
    grid-template-columns: 2rem 1fr auto;
    align-items: center;
    min-height: 52px;
    border-top: 1px solid var(--color-border);
    color: var(--color-ink);
    font: 1rem var(--font-ui);
    text-decoration: none;
  }
  .mobile-link.active { color: var(--color-cyan); }
  .link-index { color: var(--color-amber-bright); font: 0.65rem var(--font-mono); }

  .term-caret {
    display: inline-block;
    width: 0.5ch;
    height: 1.05em;
    margin-left: 0.18ch;
    transform: translateY(0.12em);
    background: var(--color-green);
    box-shadow: 0 0 10px color-mix(in oklch, var(--color-green) 55%, transparent);
    animation: caret-blink 1.06s steps(1) infinite;
  }
  @keyframes caret-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .term-caret { animation: none; opacity: 1; }
  }
  @media (max-width: 1000px) {
    :global(.site-header.is-reading) .brand { opacity: 0; pointer-events: none; }
    .reading-title { left: 1.5rem; transform: translate(0, calc(-50% + 6px)); max-width: calc(100% - 12rem); }
    :global(.site-header.is-reading) .reading-title { transform: translate(0, -50%); }
    .rm-left { display: none; }
  }
  @media (max-width: 760px) {
    .desktop-nav { display: none; }
    .mobile-actions { display: flex; }
    .reading-title { left: 1.25rem; max-width: calc(100% - 9.5rem); font-size: 0.92rem; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
  menu?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => { menu.open = false; }));

  // Show Ctrl K instead of ⌘K off Apple platforms.
  if (!/Mac|iPhone|iPad/.test(navigator.platform || navigator.userAgent)) {
    document.querySelectorAll('[data-kbd-hint]').forEach((k) => { k.textContent = 'Ctrl K'; });
  }

  // Palette triggers: open the overlay if it has hydrated, otherwise follow the link to /search/.
  document.querySelectorAll<HTMLAnchorElement>('[data-palette-open]').forEach((a) => {
    a.addEventListener('click', (event) => {
      if (!(window as any).__paletteReady || location.pathname.startsWith('/search')) return;
      event.preventDefault();
      window.dispatchEvent(new CustomEvent('palette:open'));
    });
  });

  // Keyboard fallback before the palette hydrates (it takes over once ready).
  document.addEventListener('keydown', (event) => {
    if ((window as any).__paletteReady) return;
    const target = event.target as HTMLElement | null;
    const typing = target?.matches('input, textarea, select, [contenteditable="true"]');
    const wants = (event.key.toLowerCase() === 'k' && (event.metaKey || event.ctrlKey)) || (event.key === '/' && !typing);
    if (!wants) return;
    event.preventDefault();
    const input = document.querySelector<HTMLInputElement>('#search-input');
    if (input) input.focus();
    else location.href = '/search/';
  });

  // Reading mode — title handoff + progress through the article body.
  const start = document.querySelector('[data-reading-start]');
  const body = document.querySelector<HTMLElement>('[data-reading-body]');
  const bar = header?.querySelector<HTMLElement>('.reading-meter');
  const left = header?.querySelector<HTMLElement>('[data-rm-left]');
  if (header && start && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e]) => {
      header.classList.toggle('is-reading', !e.isIntersecting && e.boundingClientRect.top < 0);
    }, { rootMargin: '-64px 0px 0px 0px' }).observe(start);
  }
  if (bar && body) {
    const minutes = Number(body.dataset.minutes || 0);
    let queued = false;
    const update = () => {
      queued = false;
      const r = body.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (-r.top + window.innerHeight * 0.25) / Math.max(1, total)));
      bar.style.setProperty('--progress', p.toFixed(4));
      if (left && minutes >= 3) {
        const m = Math.ceil(minutes * (1 - p));
        left.textContent = p >= 0.995 ? 'done' : `${m} min left`;
      }
    };
    const onScroll = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll, { passive: true });
    update();
  }
</script>
