---
import Layout from '../layouts/Layout.astro';
import { aboutPageGraph } from '../utils/jsonld';

const jsonLd = aboutPageGraph({
  url: 'https://hologramthoughts.com/how/',
  description:
    'How Hologram Thoughts is made: Matthew writes and selects the work; software helps organize themes and reading paths across the archive.',
});

const timeline = [
  { when: 'The early days', what: 'Hand-coded static pages.' },
  { when: 'For years', what: 'WordPress.' },
  { when: '2025', what: 'The archive moved to Astro.' },
  { when: '2026', what: 'Themes and reading paths connected the collection.' },
];
---
<Layout title="How this gets made — Hologram Thoughts" description="How Hologram Thoughts is written, organized, and maintained." jsonLd={jsonLd}>
  <article>
    <header class="mb-12">
      <p class="text-xs uppercase tracking-[0.18em] text-[var(--color-ink-soft)] mb-3">Colophon</p>
      <h1 class="text-4xl md:text-5xl tracking-tight leading-[1.1]" style="font-family: var(--font-display);">
        How this <span class="prismatic">gets made</span>
      </h1>
      <p class="text-lg text-[var(--color-ink-soft)] mt-6 max-w-xl leading-relaxed">
        I'm Matthew. This is my writing archive: twenty years of essays, stories, notes, and poems.
        Software helps maintain the collection and reveal connections across it. Editorial responsibility stays with me.
      </p>
    </header>

    <section class="mb-16">
      <h2 class="text-2xl mb-4" style="font-family: var(--font-display);">Authorship and organization</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <div class="rounded-2xl p-5 border border-[var(--color-border)]" style="background: color-mix(in oklch, var(--color-amber) 6%, transparent);">
          <h3 class="text-lg mb-3" style="font-family: var(--font-display);">Writing</h3>
          <ul class="space-y-1.5 text-sm text-[var(--color-ink)]">
            <li>I author and select the work published here.</li>
            <li>I decide what gets featured and how the archive is presented.</li>
            <li>When collaboration forms part of a piece, that piece says so.</li>
          </ul>
        </div>
        <div class="rounded-2xl p-5 border border-[var(--color-border)]" style="background: color-mix(in oklch, var(--color-cyan) 5%, transparent);">
          <h3 class="text-lg mb-3" style="font-family: var(--font-display);">Organization</h3>
          <ul class="space-y-1.5 text-sm text-[var(--color-ink)]">
            <li>Machine-assisted tools identify recurring themes.</li>
            <li>They draft theme summaries and related-reading paths.</li>
            <li>I review what appears on the site before publication.</li>
          </ul>
        </div>
      </div>
      <p class="mt-5 text-sm text-[var(--color-ink-soft)] leading-relaxed">
        This work happens while the site is built. No chatbot runs behind these pages, and nothing here listens to readers.
      </p>
    </section>

    <section class="mb-16">
      <h2 class="text-xl mb-4" style="font-family: var(--font-display);">How it got here</h2>
      <ol class="border-l border-[var(--color-border-strong)] pl-5 space-y-4">
        {timeline.map(t => (
          <li>
            <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-ink-soft)]" style="font-family: var(--font-ui);">{t.when}</p>
            <p class="text-[var(--color-ink)]">{t.what}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="rounded-2xl p-6 border border-dashed border-[var(--color-border-strong)]">
      <p class="text-xs uppercase tracking-[0.12em] text-[var(--color-cyan)] mb-2" style="font-family: var(--font-mono);">for agents</p>
      <p class="text-sm text-[var(--color-ink-soft)] leading-relaxed" style="font-family: var(--font-mono);">
        Every page is available as clean Markdown — append <code>?format=md</code> or send <code>Accept: text/markdown</code>.
        An index of all posts lives at <a href="/agent-index.md" class="text-[var(--color-amber-bright)] no-underline hover:text-[var(--color-cyan)]">/agent-index.md</a>.
        Theme summaries and related-reading notes are machine-assisted and human-reviewed. Published writing remains under Matthew's editorial control.
      </p>
    </section>
  </article>
</Layout>
