---
import Layout from '../../layouts/Layout.astro';
import taxonomy from '../../content/themes/taxonomy.json';

const themes = [...(taxonomy as any).themes].sort((a: any, b: any) => b.postCount - a.postCount);
const totalConnections = themes.reduce((sum: number, theme: any) => sum + theme.postCount, 0);
const maxCount = Math.max(...themes.map((theme: any) => theme.postCount));
---

<Layout wide title="Themes — Hologram Thoughts" description="Threads running through twenty years of writing, each connecting posts across the archive.">
  <header class="themes-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div>
      <p class="hero-kicker"><span></span> Archive / thematic index</p>
      <h1>The patterns<br /><em>beneath the pages.</em></h1>
    </div>
    <div class="hero-copy">
      <p>Read laterally—not by year, but by what keeps returning. These are the persistent questions, images, practices, and preoccupations running through the archive.</p>
      <dl>
        <div><dt>Threads</dt><dd>{themes.length}</dd></div>
        <div><dt>Connections</dt><dd>{totalConnections}</dd></div>
        <div><dt>Archive</dt><dd>2006—2026</dd></div>
      </dl>
    </div>
  </header>

  {themes.length === 0 ? (
    <p class="empty">No themes have been mapped yet.</p>
  ) : (
    <section class="theme-atlas" aria-labelledby="atlas-title">
      <header class="atlas-heading">
        <div>
          <p>// thread atlas</p>
          <h2 id="atlas-title">Follow what keeps returning.</h2>
        </div>
        <p>Signal strength reflects how often a thread appears. Open one to see its full movement through time.</p>
      </header>

      <ol class="theme-grid">
        {themes.map((theme: any, index: number) => {
          const strength = theme.postCount / maxCount;
          return (
            <li class:list={[index < 3 && 'theme-major']}>
              <a href={`/themes/${theme.id}/`} style={`--strength:${strength}`}>
                <div class="theme-topline">
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <span>{theme.postCount} signals</span>
                </div>
                <h3>{theme.name}</h3>
                {theme.blurb && <p>{theme.blurb}</p>}
                <div class="signal-meter" aria-hidden="true"><span></span></div>
                <span class="open-thread">Trace this thread <b aria-hidden="true">→</b></span>
              </a>
            </li>
          );
        })}
      </ol>
    </section>
  )}
</Layout>

<style>
  .themes-hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.68fr);
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    min-height: 34rem;
    margin: -1.5rem 0 0;
    padding: clamp(2rem, 5vw, 4rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 2px 2px 1.25rem 1.25rem;
    background:
      radial-gradient(circle at 14% 82%, color-mix(in oklch, var(--color-blue) 15%, transparent), transparent 30%),
      radial-gradient(circle at 82% 15%, color-mix(in oklch, var(--color-magenta) 15%, transparent), transparent 28%),
      color-mix(in oklch, var(--color-surface) 48%, transparent);
    box-shadow: 0 30px 80px oklch(0 0 0 / 0.2);
  }
  .hero-grid {
    position: absolute;
    z-index: -1;
    inset: 0;
    opacity: 0.18;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }
  .hero-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.2rem;
    color: var(--color-ink-soft);
    font: 500 0.65rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero-kicker span {
    width: 0.42rem; height: 0.42rem; border-radius: 50%;
    background: var(--color-magenta);
    box-shadow: 0 0 12px var(--color-magenta);
  }
  .themes-hero h1 {
    margin: 0;
    font-size: clamp(3.3rem, 7.5vw, 7rem);
    font-weight: 480;
    letter-spacing: -0.055em;
    line-height: 0.88;
  }
  .themes-hero h1 em { color: var(--color-blue); font-weight: inherit; }
  .hero-copy {
    padding-bottom: 0.35rem;
    color: var(--color-ink-soft);
    font-size: 1.02rem;
  }
  .hero-copy > p { margin: 0; line-height: 1.65; }
  .hero-copy dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-strong);
  }
  .hero-copy dt {
    color: var(--color-ink-faint);
    font: 0.56rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .hero-copy dd {
    margin-top: 0.35rem;
    color: var(--color-amber-bright);
    font: 0.75rem/1 var(--font-mono);
  }
  .theme-atlas { margin-top: clamp(4rem, 9vw, 8rem); }
  .atlas-heading {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.7fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: 1.5rem;
  }
  .atlas-heading > div > p {
    margin: 0 0 0.4rem;
    color: var(--color-magenta);
    font: 0.61rem/1 var(--font-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .atlas-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3.5rem); font-weight: 450; }
  .atlas-heading > p { margin: 0; color: var(--color-ink-soft); }
  .theme-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .theme-grid li { display: flex; min-width: 0; }
  .theme-grid .theme-major { grid-column: span 1; }
  .theme-grid a {
    position: relative;
    display: flex;
    width: 100%;
    min-height: 17rem;
    flex-direction: column;
    overflow: hidden;
    padding: 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background:
      linear-gradient(145deg, color-mix(in oklch, var(--color-blue) calc(var(--strength) * 8%), transparent), transparent 55%),
      color-mix(in oklch, var(--color-surface) 44%, transparent);
    color: var(--color-ink);
    text-decoration: none;
    transition: transform var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
  }
  .theme-grid a:hover {
    transform: translateY(-3px);
    border-color: color-mix(in oklch, var(--color-cyan) 55%, transparent);
    background-color: color-mix(in oklch, var(--color-blue) 7%, var(--color-surface));
  }
  .theme-topline {
    display: flex;
    justify-content: space-between;
    color: var(--color-ink-faint);
    font: 0.58rem/1 var(--font-mono);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }
  .theme-topline span:first-child { color: var(--color-blue); }
  .theme-grid h3 {
    margin: 2rem 0 0;
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    font-weight: 450;
    line-height: 1.05;
  }
  .theme-grid p {
    margin: 0.7rem 0 0;
    color: var(--color-ink-soft);
    font: italic 0.88rem/1.5 var(--font-display);
  }
  .signal-meter {
    height: 2px;
    margin-top: auto;
    background: var(--color-border);
  }
  .signal-meter span {
    display: block;
    width: calc(10% + var(--strength) * 90%);
    height: 100%;
    background: linear-gradient(90deg, var(--color-blue), var(--color-cyan), var(--color-magenta));
    box-shadow: 0 0 8px color-mix(in oklch, var(--color-cyan) 35%, transparent);
  }
  .open-thread {
    display: flex;
    justify-content: space-between;
    margin-top: 0.8rem;
    color: var(--color-cyan);
    font: 0.62rem/1 var(--font-mono);
  }
  .open-thread b { font-weight: 400; transition: transform var(--dur-fast); }
  .theme-grid a:hover .open-thread b { transform: translateX(4px); }
  .empty { padding: 5rem 0; color: var(--color-ink-soft); font-style: italic; }
  @media (max-width: 900px) {
    .themes-hero, .atlas-heading { grid-template-columns: 1fr; }
    .themes-hero { min-height: 32rem; align-content: end; }
    .theme-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 600px) {
    .themes-hero { margin: -1rem -0.2rem 0; padding: 1.25rem; }
    .themes-hero h1 { font-size: clamp(3rem, 15vw, 4.5rem); }
    .hero-copy dl { grid-template-columns: repeat(3, auto); }
    .atlas-heading { gap: 1rem; }
    .theme-grid { grid-template-columns: 1fr; }
    .theme-grid a { min-height: 14rem; }
  }
</style>
