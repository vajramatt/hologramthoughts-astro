---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { publishedPosts, themes, themeIdsFor } from '../../utils/posts';
import { collectionPageGraph } from '../../utils/jsonld';

const posts = await publishedPosts();
const firstYear = posts.at(-1)!.data.pubDate.getUTCFullYear();
const lastYear = posts[0].data.pubDate.getUTCFullYear();
const spanYears = lastYear - firstYear || 1;

// Per-thread activity by year → a tiny sparkline of when it was alive.
const activity = new Map<string, Map<number, number>>();
for (const p of posts) {
  const y = p.data.pubDate.getUTCFullYear();
  for (const id of themeIdsFor(p)) {
    if (!activity.has(id)) activity.set(id, new Map());
    const m = activity.get(id)!;
    m.set(y, (m.get(y) ?? 0) + 1);
  }
}
const list = [...themes]
  .filter((t) => t.postCount > 0)
  .sort((a, b) => b.postCount - a.postCount)
  .map((t) => {
    const m = activity.get(t.id) ?? new Map();
    const ys = [...m.keys()].sort();
    const peak = Math.max(1, ...m.values());
    return {
      ...t,
      first: ys[0],
      last: ys.at(-1),
      bars: Array.from({ length: spanYears + 1 }, (_, i) => (m.get(firstYear + i) ?? 0) / peak),
    };
  });
const total = list.reduce((s, t) => s + t.postCount, 0);

const jsonLd = collectionPageGraph({
  name: 'Threads — Hologram Thoughts',
  description: 'Recurring themes that run through twenty years of writing.',
  url: 'https://hologramthoughts.com/themes/',
  posts: list.map((t) => ({ title: t.name, url: `https://hologramthoughts.com/themes/${t.id}/` })),
});
---

<Layout wide title="Threads — Hologram Thoughts" description={`${list.length} recurring threads — ${list.slice(0, 5).map((t) => t.name.toLowerCase()).join(', ')} and more — each connecting posts across twenty years of writing.`} jsonLd={jsonLd}>
  <PageHeader
    kicker="threads"
    lede="Read sideways — not by year, but by what keeps returning. Each thread gathers the posts that share a question, a practice, or an image."
    stats={[{ label: 'threads', value: list.length }, { label: 'connections', value: total }, { label: 'span', value: `${firstYear}—${lastYear}` }]}
  >
    <Fragment slot="title">The patterns <em>beneath the pages.</em></Fragment>
  </PageHeader>

  <ol class="thread-grid">
    {list.map((t, i) => (
      <li class:list={[i < 2 && 'major']}>
        <a href={`/themes/${t.id}/`}>
          <span class="tg-top">
            <span class="tg-rank">{String(i + 1).padStart(2, '0')}</span>
            <span class="tg-count">{t.postCount} posts</span>
          </span>
          <h2>{t.name}</h2>
          {t.blurb && <p>{t.blurb}</p>}
          <span class="spark" aria-hidden="true">
            {t.bars.map((v) => <i style={`--v:${v.toFixed(3)}`}></i>)}
          </span>
          <span class="tg-years">{t.first}{t.last !== t.first ? `—${t.last}` : ''}</span>
        </a>
      </li>
    ))}
  </ol>
</Layout>

<style>
  .thread-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .thread-grid li { display: flex; }
  .thread-grid li.major { grid-column: span 2; }
  a {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    width: 100%;
    padding: var(--space-s) var(--space-s) var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background: color-mix(in oklch, var(--color-surface) 40%, transparent);
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast), background var(--dur-fast), transform var(--dur-fast) var(--ease-grow);
  }
  a:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklch, var(--color-cyan) 50%, transparent);
    background: color-mix(in oklch, var(--color-blue) 7%, var(--color-surface));
  }
  .tg-top { display: flex; justify-content: space-between; font: var(--step--2)/1 var(--font-mono); }
  .tg-rank { color: var(--color-ink-faint); }
  .tg-count { color: var(--color-amber-bright); }
  h2 { margin: 0; font-size: var(--step-2); font-weight: 480; line-height: 1.1; }
  .major h2 { font-size: var(--step-3); }
  a:hover h2 { color: var(--color-cyan); }
  p { margin: 0; color: var(--color-ink-soft); font-size: var(--step--1); line-height: 1.5; text-wrap: pretty; }
  .spark {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    align-items: end;
    gap: 2px;
    height: 1.6rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .spark i {
    display: block;
    height: calc(2px + var(--v) * 100%);
    border-radius: 1px;
    background: color-mix(in oklch, var(--color-cyan) calc(20% + var(--v) * 70%), var(--color-border));
    opacity: calc(0.35 + var(--v) * 0.65);
  }
  a:hover .spark i { background: color-mix(in oklch, var(--color-magenta) calc(25% + var(--v) * 70%), var(--color-border)); }
  .tg-years { color: var(--color-ink-faint); font: var(--step--2)/1 var(--font-mono); }
  @media (max-width: 640px) {
    .thread-grid li.major { grid-column: auto; }
  }
</style>
