---
import Layout from '../../layouts/Layout.astro';
import taxonomy from '../../content/themes/taxonomy.json';
import { getCollection } from 'astro:content';
import { readdir, readFile } from 'node:fs/promises';
import { join } from 'node:path';
import { renderSynthesis } from '../../utils/sanitize-synthesis';
import { collectionPageGraph } from '../../utils/jsonld';

export async function getStaticPaths() {
  const themes = (taxonomy as any).themes;
  const themeDir = 'src/content/themes';
  const byTheme: Record<string, string[]> = {};
  let files: string[] = [];
  try {
    files = (await readdir(themeDir)).filter(f => f.endsWith('.json') && f !== 'taxonomy.json');
  } catch { files = []; }
  for (const file of files) {
    const sidecar = JSON.parse(await readFile(join(themeDir, file), 'utf8'));
    for (const id of sidecar.themeIds) (byTheme[id] ??= []).push(sidecar.slug);
  }
  return themes.map((theme: any) => ({
    params: { id: theme.id },
    props: { theme, slugs: byTheme[theme.id] ?? [] },
  }));
}

const { theme, slugs } = Astro.props;
const all = await getCollection('blog', ({ data }) => !data.draft);
const bySlug = new Map<string, any>();
for (const post of all) {
  const idBase = post.id.replace(/\.md$/, '');
  if (post.data.slug) bySlug.set(post.data.slug, post);
  if ((post as any).slug) bySlug.set((post as any).slug, post);
  bySlug.set(idBase, post);
}
const posts = (slugs as string[])
  .map(slug => bySlug.get(slug))
  .filter(Boolean)
  .sort((a: any, b: any) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());

const byYear: Array<{ year: number; group: any[] }> = [];
for (const post of posts) {
  const year = post.data.pubDate.getUTCFullYear();
  const last = byYear[byYear.length - 1];
  if (last?.year === year) last.group.push(post);
  else byYear.push({ year, group: [post] });
}

const firstYear = posts[0]?.data.pubDate.getUTCFullYear();
const lastYear = posts.at(-1)?.data.pubDate.getUTCFullYear();
const span = firstYear && lastYear ? lastYear - firstYear + 1 : 0;
const slugOf = (post: any) => post.slug ?? post.data.slug ?? post.id.replace(/\.md$/, '');
const jsonLd = collectionPageGraph({
  name: theme.name,
  description: theme.blurb || `Posts on ${theme.name}.`,
  url: `https://hologramthoughts.com/themes/${theme.id}/`,
  posts: posts.map((post: any) => ({
    title: post.data.title,
    url: `https://hologramthoughts.com/blog/${slugOf(post)}/`,
  })),
});
---

<Layout wide title={`${theme.name} — Hologram Thoughts`} description={theme.blurb} jsonLd={jsonLd}>
  <header class="thread-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <a href="/themes/" class="back-link">← thematic index</a>
    <p class="thread-kicker"><span></span> Muse / thread dossier</p>
    <h1>{theme.name}</h1>
    {theme.blurb && <p class="thread-deck">{theme.blurb}</p>}
    <dl class="thread-stats">
      <div><dt>Signals</dt><dd>{posts.length}</dd></div>
      <div><dt>First seen</dt><dd>{firstYear ?? '—'}</dd></div>
      <div><dt>Last seen</dt><dd>{lastYear ?? '—'}</dd></div>
      <div><dt>Span</dt><dd>{span ? `${span} years` : '—'}</dd></div>
    </dl>
  </header>

  <div class="thread-layout">
    <aside class="thread-rail">
      <div>
        <p>// active years</p>
        <nav aria-label="Years in this thread">
          {byYear.map(({ year, group }) => (
            <a href={`#year-${year}`}><span>{year}</span><small>{group.length}</small></a>
          ))}
        </nav>
        <a class="all-themes" href="/themes/">All {((taxonomy as any).themes as any[]).length} threads →</a>
      </div>
    </aside>

    <main class="thread-main">
      {theme.synthesis && (
        <section class="muse-reading" aria-labelledby="muse-reading-title">
          <header>
            <div>
              <span aria-hidden="true">✦</span>
              <div>
                <p>MUSE.md / synthesis</p>
                <h2 id="muse-reading-title">What the thread reveals</h2>
              </div>
            </div>
            <small>machine-curated<br />human-approved</small>
          </header>
          <div class="synthesis" set:html={renderSynthesis(theme.synthesis as string)} />
        </section>
      )}

      <section class="thread-chronology" aria-labelledby="chronology-title">
        <header class="chronology-heading">
          <div>
            <p>// chronological trace</p>
            <h2 id="chronology-title">The thread through time</h2>
          </div>
          <p>{posts.length} posts across {byYear.length} active {byYear.length === 1 ? 'year' : 'years'}, oldest to newest.</p>
        </header>

        <ol class="year-trace">
          {byYear.map(({ year, group }) => (
            <li class="trace-year" id={`year-${year}`}>
              <header>
                <span>{year}</span>
                <small>{group.length} {group.length === 1 ? 'signal' : 'signals'}</small>
              </header>
              <ol>
                {group.map((post: any) => {
                  const slug = slugOf(post);
                  return (
                    <li>
                      <a href={`/blog/${slug}/`}>
                        <time datetime={post.data.pubDate.toISOString()}>
                          {post.data.pubDate.toLocaleDateString('en', { month: 'short', day: '2-digit', timeZone: 'UTC' })}
                        </time>
                        <span>
                          <strong>{post.data.title}</strong>
                          {post.data.description && <small>{post.data.description}</small>}
                        </span>
                        <b aria-hidden="true">→</b>
                      </a>
                    </li>
                  );
                })}
              </ol>
            </li>
          ))}
        </ol>
      </section>
    </main>
  </div>
</Layout>

<style>
  :global(html) { scroll-padding-top: 6rem; }
  .thread-hero {
    position: relative;
    isolation: isolate;
    min-height: 31rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    margin: -1.5rem 0 0;
    padding: clamp(2rem, 5vw, 4rem);
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 2px 2px 1.25rem 1.25rem;
    background:
      radial-gradient(circle at 78% 24%, color-mix(in oklch, var(--color-magenta) 16%, transparent), transparent 29%),
      radial-gradient(circle at 12% 92%, color-mix(in oklch, var(--color-blue) 14%, transparent), transparent 34%),
      color-mix(in oklch, var(--color-surface) 48%, transparent);
    box-shadow: 0 30px 80px oklch(0 0 0 / 0.2);
  }
  .hero-grid {
    position: absolute; z-index: -1; inset: 0; opacity: 0.18;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 92%);
  }
  .back-link {
    position: absolute;
    top: 1.5rem;
    left: clamp(2rem, 5vw, 4rem);
    color: var(--color-ink-soft);
    font: 500 0.65rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
  }
  .back-link:hover { color: var(--color-cyan); }
  .thread-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0 0 1rem;
    color: var(--color-ink-soft);
    font: 500 0.64rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .thread-kicker span {
    width: 0.42rem; height: 0.42rem; border-radius: 50%;
    background: var(--color-magenta); box-shadow: 0 0 12px var(--color-magenta);
  }
  .thread-hero h1 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    font-weight: 480;
    letter-spacing: -0.06em;
    line-height: 0.9;
    text-wrap: balance;
  }
  .thread-deck {
    max-width: 54ch;
    margin: 1.35rem 0 0;
    color: var(--color-ink-soft);
    font: italic 1.15rem/1.55 var(--font-display);
  }
  .thread-stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    max-width: 45rem;
    margin: 2.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-strong);
  }
  .thread-stats div { padding-right: 1rem; }
  .thread-stats dt {
    color: var(--color-ink-faint);
    font: 0.56rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .thread-stats dd {
    margin-top: 0.4rem;
    color: var(--color-amber-bright);
    font: 0.72rem/1 var(--font-mono);
  }
  .thread-layout {
    display: grid;
    grid-template-columns: 9rem minmax(0, 48rem);
    justify-content: center;
    gap: clamp(2rem, 7vw, 6rem);
    margin-top: clamp(3rem, 7vw, 6rem);
  }
  .thread-rail > div { position: sticky; top: 6rem; }
  .thread-rail p {
    margin: 0 0 0.7rem;
    color: var(--color-magenta);
    font: 0.58rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .thread-rail nav { display: flex; flex-direction: column; }
  .thread-rail nav a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: 34px;
    padding: 0.2rem 0.4rem;
    border-left: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    font: 0.68rem/1 var(--font-mono);
    text-decoration: none;
  }
  .thread-rail nav a:hover { border-left-color: var(--color-cyan); color: var(--color-cyan); }
  .thread-rail small { color: var(--color-ink-faint); font-size: 0.56rem; }
  .all-themes {
    display: block;
    margin-top: 1.25rem;
    color: var(--color-ink-faint);
    font: 0.62rem/1.5 var(--font-mono);
    text-decoration: none;
  }
  .all-themes:hover { color: var(--color-cyan); }
  .thread-main { min-width: 0; }
  .muse-reading {
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--color-border-strong);
    border-radius: 10px;
    background:
      linear-gradient(135deg, color-mix(in oklch, var(--color-magenta) 8%, transparent), transparent 55%),
      color-mix(in oklch, var(--color-surface) 60%, transparent);
    box-shadow: var(--shadow-deep);
  }
  .muse-reading > header {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: start;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .muse-reading > header > div { display: flex; gap: 0.75rem; }
  .muse-reading > header > div > span { color: var(--color-magenta); text-shadow: 0 0 12px var(--color-magenta); }
  .muse-reading header p {
    margin: 0 0 0.2rem;
    color: var(--color-magenta);
    font: 0.57rem/1 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .muse-reading h2 { margin: 0; font-size: 1.5rem; font-weight: 450; }
  .muse-reading header small {
    color: var(--color-ink-faint);
    font: 0.55rem/1.5 var(--font-mono);
    text-align: right;
    text-transform: uppercase;
  }
  .synthesis {
    padding-top: 1.25rem;
    color: var(--color-ink-soft);
    font-size: 1.02rem;
    line-height: 1.72;
  }
  .synthesis :global(p) { margin: 0; }
  .synthesis :global(a) { color: var(--color-amber-bright); }
  .chronology-heading {
    display: grid;
    grid-template-columns: 1fr minmax(14rem, 0.65fr);
    gap: 2rem;
    align-items: end;
    margin: clamp(4rem, 8vw, 7rem) 0 1.5rem;
  }
  .chronology-heading > div > p {
    margin: 0 0 0.35rem;
    color: var(--color-magenta);
    font: 0.59rem/1 var(--font-mono);
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  .chronology-heading h2 { margin: 0; font-size: clamp(2rem, 4vw, 3rem); font-weight: 450; }
  .chronology-heading > p { margin: 0; color: var(--color-ink-soft); font-size: 0.9rem; }
  .year-trace, .year-trace ol { margin: 0; padding: 0; list-style: none; }
  .trace-year {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
    scroll-margin-top: 6rem;
    padding: 0 0 2.5rem;
  }
  .trace-year > header { position: relative; padding-top: 1rem; border-top: 1px solid var(--color-border-strong); }
  .trace-year > header::after {
    content: "";
    position: absolute;
    right: -0.78rem;
    top: 1.25rem;
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--color-blue);
    box-shadow: 0 0 9px var(--color-blue);
  }
  .trace-year > header span {
    display: block;
    color: var(--color-blue);
    font: 500 1.25rem/1 var(--font-display);
  }
  .trace-year > header small {
    color: var(--color-ink-faint);
    font: 0.54rem/1 var(--font-mono);
    text-transform: uppercase;
  }
  .trace-year > ol { border-left: 1px solid var(--color-border); }
  .trace-year li { border-top: 1px solid var(--color-border); }
  .trace-year li:last-child { border-bottom: 1px solid var(--color-border); }
  .trace-year li a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 2rem;
    gap: 1rem;
    align-items: center;
    min-height: 78px;
    padding: 0.8rem 0.4rem 0.8rem 1rem;
    color: var(--color-ink);
    text-decoration: none;
    transition: background var(--dur-fast);
  }
  .trace-year li a:hover { background: linear-gradient(90deg, color-mix(in oklch, var(--color-blue) 7%, transparent), transparent); }
  .trace-year time { color: var(--color-amber-bright); font: 0.58rem/1 var(--font-mono); text-transform: uppercase; }
  .trace-year strong { display: block; font: 450 1.14rem/1.2 var(--font-display); }
  .trace-year a span small {
    display: -webkit-box;
    margin-top: 0.3rem;
    overflow: hidden;
    color: var(--color-ink-faint);
    font: 0.78rem/1.4 var(--font-body);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
  }
  .trace-year a > b { color: var(--color-ink-faint); font-weight: 400; }
  .trace-year li a:hover strong { color: var(--color-cyan); }
  .trace-year li a:hover > b { color: var(--color-magenta); }
  @media (max-width: 800px) {
    .thread-layout { grid-template-columns: 1fr; }
    .thread-rail { position: sticky; z-index: 5; top: 64px; overflow-x: auto; margin-inline: -1.25rem; padding: 0.65rem 1.25rem; border-block: 1px solid var(--color-border); background: color-mix(in oklch, var(--color-bg) 92%, transparent); backdrop-filter: blur(16px); }
    .thread-rail > div { position: static; width: max-content; }
    .thread-rail p, .all-themes { display: none; }
    .thread-rail nav { flex-direction: row; }
    .thread-rail nav a { min-width: 62px; min-height: 38px; flex-direction: column; justify-content: center; border-left: 0; border-bottom: 1px solid var(--color-border); }
  }
  @media (max-width: 600px) {
    .thread-hero { min-height: 28rem; margin: -1rem -0.2rem 0; padding: 4rem 1.25rem 1.5rem; }
    .back-link { left: 1.25rem; }
    .thread-hero h1 { font-size: clamp(3rem, 15vw, 4.6rem); }
    .thread-stats { grid-template-columns: repeat(2, 1fr); gap: 1rem 0; }
    .chronology-heading { grid-template-columns: 1fr; gap: 0.7rem; }
    .trace-year { grid-template-columns: 4rem minmax(0, 1fr); gap: 0.7rem; }
    .trace-year li a { grid-template-columns: minmax(0, 1fr) 1.5rem; gap: 0.5rem; padding-left: 0.75rem; }
    .trace-year time { grid-column: 1 / -1; }
  }
</style>
