---
import Layout from '../layouts/Layout.astro';
import MuseHighlight from '../components/MuseHighlight.astro';
import ThreadLines from '../components/ThreadLines.astro';
import { threadSeries } from '../utils/thread-years';
import PostCard from '../components/PostCard.astro';
import { metaDescription } from '../utils/deck';
import { blogGraph } from '../utils/jsonld';
import { getCollection } from 'astro:content';
import taxonomy from '../content/themes/taxonomy.json';
import { readFile } from 'node:fs/promises';
import yaml from 'js-yaml';

const all = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Use Astro's canonical post.slug (matches the URL the [slug].astro getStaticPaths generates)
const slugOf = (p: any) => p.slug ?? p.id.replace(/\.md$/, '');
// Frontmatter slug may differ from Astro slug — use frontmatter for sidecar JSON lookups
const sidecarKey = (p: any) => p.data.slug ?? p.slug ?? p.id.replace(/\.md$/, '');

// Read Muse picks (hand-curated overrides)
type StoryEntry = string | { series: string };
interface MusePicks {
  stories?: StoryEntry[];
  latest?: string[];
  threads?: string[];
  featured_note?: string;
  start_here?: string[];
}
let picks: MusePicks = {};
try {
  picks = yaml.load(await readFile('src/data/muse-picks.yaml', 'utf8')) as MusePicks ?? {};
} catch { /* no picks file */ }

// Build a slug-keyed map so picks can use frontmatter slug, astro slug, or filename
const postBySlug = new Map<string, any>();
for (const p of all) {
  if (p.data.slug) postBySlug.set(p.data.slug, p);
  if ((p as any).slug) postBySlug.set((p as any).slug, p);
  postBySlug.set(p.id.replace(/\.md$/, ''), p);
}
const pickToSlug = (s: string) => {
  const p = postBySlug.get(s);
  return p ? slugOf(p) : null;
};

// Chronological latest is a permanent, non-editorial homepage surface. Muse's
// hand-picked posts are kept separate so "new" can never mean "recommended".
const latestPosts = all.slice(0, 3);
const musePostSlugs = (picks.latest?.length ? picks.latest.map(pickToSlug).filter(Boolean) as string[]
  : all.slice(3, 8).map(slugOf));

const countByYear = new Map<number, number>();
for (const post of all) {
  const year = post.data.pubDate.getUTCFullYear();
  countByYear.set(year, (countByYear.get(year) ?? 0) + 1);
}
// Every year from first post to latest — quiet years included, so the gaps read as part of the story.
const yearsWithPosts = [...countByYear.keys()];
const archiveYears: { year: number; count: number }[] = [];
for (let y = Math.max(...yearsWithPosts); y >= Math.min(...yearsWithPosts); y--) {
  archiveYears.push({ year: y, count: countByYear.get(y) ?? 0 });
}
const maxYearCount = Math.max(...archiveYears.map((item) => item.count));

// Stories: mix of single posts and series groups.
// Single → { kind: 'post', slug, title, pubDate }
// Series → { kind: 'series', name, parts: [{ slug, title, pubDate, order }] }
type StoryItem =
  | { kind: 'post'; slug: string; title: string; pubDate: Date }
  | { kind: 'series'; name: string; parts: Array<{ slug: string; title: string; pubDate: Date; order: number }> };
const stories: StoryItem[] = [];
if (picks.stories?.length) {
  for (const entry of picks.stories) {
    if (typeof entry === 'string') {
      const p = postBySlug.get(entry);
      if (p) stories.push({ kind: 'post', slug: slugOf(p), title: p.data.title, pubDate: p.data.pubDate });
    } else if (entry?.series) {
      const seriesName = entry.series;
      const parts = all
        .filter(p => p.data.series === seriesName)
        .map(p => ({ slug: slugOf(p), title: p.data.title, pubDate: p.data.pubDate, order: p.data.seriesOrder ?? 999 }))
        .sort((a, b) => a.order - b.order);
      if (parts.length) stories.push({ kind: 'series', name: seriesName, parts });
    }
  }
} else {
  const fallback = all.filter(p => p.data.contentType === 'story').slice(0, 5);
  for (const p of fallback) {
    stories.push({ kind: 'post', slug: slugOf(p), title: p.data.title, pubDate: p.data.pubDate });
  }
}

const themesById = new Map<string, any>((taxonomy as any).themes.map((t: any) => [t.id, t]));
const activeThemes = (picks.threads?.length
  ? picks.threads.map(id => themesById.get(id)).filter(Boolean)
  : [...(taxonomy as any).themes].sort((a: any, b: any) => b.postCount - a.postCount).slice(0, 6)
).map((t: any) => ({ id: t.id, name: t.name, blurb: t.blurb, postCount: t.postCount }));

const featuredNote = picks.featured_note?.trim() || null;

// "Start here": a few doorways for first-time readers. Hand-picked via
// muse-picks.yaml `start_here`, else the first stories (series → part one).
const startHere: any[] = [];
if (picks.start_here?.length) {
  for (const s of picks.start_here) { const p = postBySlug.get(s); if (p) startHere.push(p); }
} else {
  for (const entry of picks.stories ?? []) {
    if (typeof entry === 'string') { const p = postBySlug.get(entry); if (p) startHere.push(p); }
    else if (entry?.series) {
      const first = all.filter((p) => p.data.series === entry.series).sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))[0];
      if (first) startHere.push(first);
    }
  }
}
const startHereItems = [...new Set(startHere)].slice(0, 4);

// ── Lines through the archive: posts per thread per year ──
// Every thread's posts bucketed by year on a true, linear axis, so the reader sees
// when each one ran, where it peaked, and what came back after the quiet years.
const validThemeIds = new Set<string>((taxonomy as any).themes.map((t: any) => t.id));
const sidecarMods = import.meta.glob('../content/themes/*.json', { eager: true });
const themeDates = new Map<string, number[]>();
for (const mod of Object.values(sidecarMods)) {
  const sc = (mod as any).default;
  if (!sc || !Array.isArray(sc.themeIds)) continue; // skip taxonomy.json
  const post = postBySlug.get(sc.slug);
  if (!post) continue;
  for (const id of new Set<string>(sc.themeIds.filter((id: string) => validThemeIds.has(id)))) {
    if (!themeDates.has(id)) themeDates.set(id, []);
    themeDates.get(id)!.push(post.data.pubDate.valueOf());
  }
}
const firstYear = Math.min(...yearsWithPosts);
const lastYear = Math.max(...yearsWithPosts);
const threads = threadSeries((taxonomy as any).themes, themeDates, firstYear, lastYear);
const quietYears = archiveYears.filter((y) => y.count === 0).map((y) => y.year);

// Theme ids for both chronological Latest and Muse's resurfaced selections.
const themeIdsByPostSlug: Record<string, string[]> = {};
const themedSlugs = [...new Set([...latestPosts.map(slugOf), ...musePostSlugs])];
for (const s of themedSlugs) {
  const p = postBySlug.get(s);
  if (!p) { themeIdsByPostSlug[s] = []; continue; }
  try {
    const sc = await import(`../content/themes/${sidecarKey(p)}.json`);
    themeIdsByPostSlug[s] = sc.default.themeIds ?? [];
  } catch {
    themeIdsByPostSlug[s] = [];
  }
}
---
<Layout wide signal title="Hologram Thoughts — an archive of attention by Matthew Williamson" description={`${all.length} essays, stories and poems from ${Math.min(...yearsWithPosts)}–${Math.max(...yearsWithPosts)} on consciousness, Buddhist practice, fatherhood, mythology, code and the strange edges of culture — connected by recurring threads.`} jsonLd={blogGraph({ posts: all.slice(0, 12).map((p) => ({ title: p.data.title, url: `https://hologramthoughts.com/blog/${slugOf(p)}/`, datePublished: p.data.pubDate.toISOString() })) })}>
  <section class="home-hero" aria-labelledby="home-title" data-signal-zone>
    <div class="hero-copy">
      <p class="terminal-line" aria-hidden="true">
        <span class="prompt-user">archive@hologram</span><span class="prompt-faint">:</span><span class="prompt-path">~</span><span class="prompt-faint">$</span>
        <span class="term-cmd-wrap">
          <span class="term-ghost">replay ./archive --era 2006..2026</span>
          <span class="term-cmd"><span data-tw-cmd>replay ./archive --era 2006..2026</span><span class="term-mini-caret" data-cmd-caret></span></span>
        </span>
      </p>
      <h1 id="home-title" class="hero-title" data-hero-title>
        <span class="prismatic">An archive</span>
        <span>of attention.<span class="hero-caret" aria-hidden="true"></span></span>
      </h1>
      <p class="hero-intro" data-hero-reveal>
        Twenty years of writing on consciousness, dharma, fatherhood, code, and the strange edges of culture—kept here so it doesn’t get lost in the scroll.
      </p>
      <div class="hero-actions" data-hero-reveal>
        <a href="#latest" class="command-link"><span aria-hidden="true">›</span> read --latest</a>
        <a href="#understory" class="command-link secondary"><span aria-hidden="true">›</span> explore --threads</a>
      </div>
    </div>

    <aside id="latest" class="latest-panel console" aria-labelledby="latest-title">
      <div class="latest-heading">
        <div>
          <p class="panel-kicker">Live index</p>
          <h2 id="latest-title">Latest writing</h2>
        </div>
        <span class="status-dot" aria-label="Archive active"></span>
      </div>
      <ol class="latest-list">
        {latestPosts.map((post: any, index) => {
          const slug = slugOf(post);
          const ids = (themeIdsByPostSlug[slug] ?? []).slice(0, 2);
          return (
            <li>
              <a href={`/blog/${slug}/`} class="latest-link">
                <span class="latest-index">0{index + 1}</span>
                <span class="latest-copy">
                  <span class="latest-title">{post.data.title}</span>
                  <span class="latest-description">{metaDescription(post.data.description, post.body, 140)}</span>
                  <span class="latest-themes">
                    {ids.map((id) => {
                      const theme = themesById.get(id);
                      return theme && <span>{theme.name}</span>;
                    })}
                  </span>
                </span>
                <time datetime={post.data.pubDate.toISOString()}>
                  {post.data.pubDate.toLocaleDateString('en', { month: 'short', day: '2-digit', timeZone: 'UTC' })}
                </time>
              </a>
            </li>
          );
        })}
      </ol>
      <a class="latest-all" href="/archive/">View every post <span aria-hidden="true">→</span></a>
    </aside>
  </section>
  <script is:inline>
    // Type one short command, then reveal the complete literary headline. Full text
    // remains in the HTML for SEO/no-JS and reduced-motion visitors.
    (() => {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const cmd = document.querySelector('[data-tw-cmd]');
      const cmdCaret = document.querySelector('[data-cmd-caret]');
      const title = document.querySelector('[data-hero-title]');
      const reveals = document.querySelectorAll('[data-hero-reveal]');
      if (!cmd || !cmdCaret || !title) return;
      const cmdText = cmd.textContent;
      cmd.textContent = '';
      title.classList.add('reveal-pending');
      reveals.forEach((el) => el.classList.add('reveal-pending'));
      const events = [];
      let t = 120;
      events.push([t, () => cmdCaret.classList.add('caret-typing')]);
      for (let k = 0; k < cmdText.length; k++) {
        t += 18 * (0.72 + Math.random() * 0.55);
        const n = k + 1;
        events.push([t, () => { cmd.textContent = cmdText.slice(0, n); }]);
      }
      events.push([t += 80, () => cmdCaret.classList.remove('caret-typing')]);
      events.push([t += 80, () => {
        title.classList.remove('reveal-pending');
        title.classList.add('revealed');
        reveals.forEach((el) => el.classList.remove('reveal-pending'));
      }]);

      const startAt = performance.now();
      let idx = 0;
      let tid = 0;
      let rid = 0;
      const step = () => {
        clearTimeout(tid);
        cancelAnimationFrame(rid);
        const elapsed = performance.now() - startAt;
        while (idx < events.length && events[idx][0] <= elapsed) events[idx++][1]();
        if (idx < events.length) {
          rid = requestAnimationFrame(step);
          tid = setTimeout(step, 150);
        }
      };
      step();
    })();
  </script>

  {startHereItems.length > 0 && (
    <section class="start-here" aria-labelledby="start-title">
      <div class="section-label"><h2 id="start-title">start here</h2><p>four doorways into twenty years</p></div>
      <ul>
        {startHereItems.map((p) => <li><PostCard post={p} label={p.data.series ? `${p.data.series} · part 1` : undefined} /></li>)}
      </ul>
    </section>
  )}

  <section class="year-doorway" aria-labelledby="years-title">
    <div class="year-intro">
      <p class="section-kicker">Twenty years in the archive</p>
      <h2 id="years-title">Find the year you remember.</h2>
      <p>Every year is a doorway. Follow chronology, then let the threads take over.</p>
    </div>
    <div class="year-rail-shell">
      <div class="year-rail" aria-label="Browse archive by year" data-year-rail>
        {archiveYears.map(({ year, count }) => count > 0 ? (
          <a href={`/archive/#year-${year}`} class="year-link">
            <span class="year-value">{year}</span>
            <span class="year-bar" style={`--year-density:${count / maxYearCount}`}></span>
            <span class="year-count">{count} {count === 1 ? 'post' : 'posts'}</span>
          </a>
        ) : (
          <span class="year-link is-quiet" aria-label={`${year}: no posts`}>
            <span class="year-value">{year}</span>
            <span class="year-bar"></span>
            <span class="year-count">quiet</span>
          </span>
        ))}
      </div>
      <button class="year-scroll-cue" type="button" data-year-scroll aria-label="Show earlier archive years">
        <span>earlier</span>
        <b aria-hidden="true">→</b>
      </button>
    </div>
    <a class="browse-archive" href="/archive/">Browse the complete chronology <span aria-hidden="true">→</span></a>
  </section>

  <script>
    const rail = document.querySelector<HTMLElement>('[data-year-rail]');
    const cue = document.querySelector<HTMLButtonElement>('[data-year-scroll]');
    if (rail && cue) {
      const updateCue = () => {
        const atEnd = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 8;
        cue.classList.toggle('is-hidden', atEnd);
      };
      cue.addEventListener('click', () => {
        rail.scrollBy({
          left: Math.max(280, rail.clientWidth * 0.72),
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
        });
      });
      rail.addEventListener('scroll', updateCue, { passive: true });
      updateCue();
    }
  </script>

  <MuseHighlight
    postSlugs={musePostSlugs}
    activeThemes={activeThemes}
    stories={stories}
    themeIdsBySlug={themeIdsByPostSlug}
    featuredNote={featuredNote}
  />

  <section id="understory" class="understory-zone">
    <div class="understory-heading">
      <p class="section-kicker">The understory</p>
      <h2>Lines through the archive</h2>
      <p>
        Each thread, year by year, from {firstYear} to now. The amber bar is its busiest year. The long quiet in the middle is real, and so is the return.
      </p>
    </div>
    <ThreadLines series={threads} from={firstYear} to={lastYear} quietYears={quietYears} />
    <p class="map-exit"><a href="/themes/">every thread, with its story →</a></p>
  </section>
</Layout>

<style>
  .home-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(20rem, 0.92fr);
    gap: clamp(2rem, 5vw, 5.5rem);
    align-items: center;
    min-height: min(690px, calc(100vh - 8rem));
    padding: clamp(2rem, 6vw, 5.5rem) 0;
    isolation: isolate;
  }
  .home-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    width: min(760px, 76vw);
    height: min(640px, 70vw);
    left: -20%;
    top: -7%;
    background:
      radial-gradient(circle at 50% 44%, color-mix(in oklch, var(--color-blue) 16%, transparent), transparent 48%),
      radial-gradient(circle at 72% 64%, color-mix(in oklch, var(--color-cyan) 8%, transparent), transparent 40%);
    filter: blur(24px);
    opacity: 0.92;
    pointer-events: none;
  }
  .hero-copy { min-width: 0; }
  .terminal-line {
    margin: 0 0 1.8rem;
    min-width: 0;
    color: var(--color-ink-soft);
    font: clamp(0.68rem, 1.2vw, 0.8rem) var(--font-mono);
    white-space: nowrap;
  }
  .prompt-user { color: var(--color-green); }
  .prompt-path { color: var(--color-blue); }
  .prompt-faint { color: var(--color-ink-faint); }
  .term-cmd-wrap { position: relative; display: inline-block; }
  .term-ghost { visibility: hidden; white-space: pre; }
  .term-cmd { position: absolute; left: 0; top: 0; color: var(--color-ink-soft); white-space: pre; }
  .term-mini-caret {
    display: inline-block;
    width: 0.55ch;
    height: 1em;
    margin-left: 0.12ch;
    transform: translateY(0.18em);
    background: var(--color-green);
    opacity: 0;
  }
  .term-mini-caret.caret-typing { opacity: 1; }
  .hero-title {
    margin: 0;
    font-size: clamp(3.65rem, 7.4vw, 7.1rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }
  .hero-title > span { display: block; }
  .hero-title > span:last-child { color: var(--color-ink); }
  .hero-title.reveal-pending {
    opacity: 0;
    transform: translateY(10px);
    filter: blur(10px);
  }
  .hero-title.revealed {
    animation: title-bloom 680ms var(--ease-grow) both;
  }
  @keyframes title-bloom {
    from { opacity: 0; transform: translateY(10px); filter: blur(10px); clip-path: inset(0 100% 0 0); }
    to { opacity: 1; transform: none; filter: blur(0); clip-path: inset(0); }
  }
  .hero-caret {
    display: inline-block;
    width: 0.48ch;
    height: 0.78em;
    margin-left: 0.14ch;
    transform: translateY(0.06em);
    background: var(--color-green);
    box-shadow: 0 0 18px color-mix(in oklch, var(--color-green) 55%, transparent);
    animation: hero-blink 1.06s steps(1) infinite;
  }
  @keyframes hero-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  .hero-intro {
    max-width: 38rem;
    margin: 2rem 0 0;
    color: var(--color-ink-soft);
    font-size: clamp(1.05rem, 1.8vw, 1.22rem);
    line-height: 1.65;
  }
  [data-hero-reveal] { transition: opacity 520ms var(--ease-grow), transform 520ms var(--ease-grow); }
  [data-hero-reveal].reveal-pending { opacity: 0; transform: translateY(8px); }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; margin-top: 1.75rem; }
  .command-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 44px;
    color: var(--color-cyan);
    font: 0.78rem var(--font-mono);
    text-decoration: none;
  }
  .command-link span { color: var(--color-green); }
  .command-link.secondary { color: var(--color-ink-soft); }
  .command-link:hover { color: var(--color-magenta); }

  /* Material (bg, border, shadow) comes from global .console. */
  .latest-panel {
    min-width: 0;
    padding: clamp(1.25rem, 3vw, 2rem);
  }
  .latest-panel::before {
    content: "";
    position: absolute;
    inset: 0.75rem 1.2rem auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-blue), var(--color-magenta), transparent);
    opacity: 0.7;
  }
  .latest-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: start; padding: 0.25rem 0 1rem; }
  .panel-kicker, .section-kicker {
    margin: 0 0 0.25rem;
    color: var(--color-magenta);
    font: 0.64rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .latest-heading h2 { margin: 0; font-size: clamp(1.45rem, 2.4vw, 1.9rem); }
  .status-dot {
    width: 8px;
    height: 8px;
    margin-top: 0.7rem;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 12px color-mix(in oklch, var(--color-green) 75%, transparent);
  }
  .latest-list { margin: 0; padding: 0; list-style: none; }
  .latest-list li { border-top: 1px solid var(--color-border); }
  .latest-link {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: start;
    min-height: 44px;
    padding: 1rem 0;
    color: var(--color-ink);
    text-decoration: none;
  }
  .latest-index { padding-top: 0.2rem; color: var(--color-blue); font: 0.62rem var(--font-mono); }
  .latest-copy { display: flex; min-width: 0; flex-direction: column; }
  .latest-title { color: var(--color-ink); font: 500 clamp(1.05rem, 1.8vw, 1.25rem)/1.2 var(--font-display); }
  .latest-description {
    display: -webkit-box;
    margin-top: 0.25rem;
    overflow: hidden;
    color: var(--color-ink-soft);
    font-size: 0.82rem;
    line-height: 1.4;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }
  .latest-themes { display: flex; flex-wrap: wrap; gap: 0.35rem 0.65rem; margin-top: 0.55rem; }
  .latest-themes span { color: var(--color-magenta); font: 0.6rem var(--font-mono); text-transform: uppercase; }
  .latest-link time { padding-top: 0.2rem; color: var(--color-amber-bright); font: 0.6rem var(--font-mono); text-transform: uppercase; }
  .latest-link:hover .latest-title { color: var(--color-cyan); }
  .latest-link:hover .latest-index { color: var(--color-magenta); }
  .latest-all, .browse-archive {
    display: inline-flex;
    gap: 0.5rem;
    margin-top: 0.8rem;
    color: var(--color-cyan);
    font: 0.75rem var(--font-mono);
    text-decoration: none;
  }

  .year-doorway {
    position: relative;
    margin: clamp(3rem, 7vw, 6rem) 0;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    background:
      linear-gradient(115deg, color-mix(in oklch, var(--color-blue) 7%, transparent), transparent 42%),
      color-mix(in oklch, var(--color-bg-soft) 56%, transparent);
    border-block: 1px solid var(--color-border);
  }
  .year-intro { display: grid; grid-template-columns: minmax(14rem, 0.75fr) 1fr; gap: 0 3rem; align-items: end; margin-bottom: 1.5rem; }
  .year-intro .section-kicker { grid-column: 1 / -1; }
  .year-intro h2 { margin: 0; font-size: clamp(1.8rem, 3vw, 2.65rem); }
  .year-intro > p:last-child { margin: 0; max-width: 35rem; color: var(--color-ink-soft); }
  .year-rail-shell { position: relative; }
  .year-rail {
    display: flex;
    gap: 0.6rem;
    overflow-x: auto;
    padding: 0.4rem 7rem 0.8rem 0;
    scrollbar-width: thin;
