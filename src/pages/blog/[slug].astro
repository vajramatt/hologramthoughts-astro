---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ThemeChipStrip from '../../components/ThemeChipStrip.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import type { PostSidecar } from '../../lib/themes';
import { blogPostingGraph } from '../../utils/jsonld';
import { categoryColor } from '../../utils/category-color';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const sortedPosts = posts.sort((a, b) =>
    new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf()
  );

  return sortedPosts.map((post, index) => {
    let prevPost = index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null;
    let nextPost = index > 0 ? sortedPosts[index - 1] : null;

    // If this post belongs to a series, use series order for prev/next
    if (post.data.series && post.data.seriesOrder !== undefined) {
      const seriesPosts = posts
        .filter(p => p.data.series === post.data.series && p.data.seriesOrder !== undefined)
        .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0));
      const seriesIndex = seriesPosts.findIndex(p => p.slug === post.slug);
      prevPost = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : null;
      nextPost = seriesIndex < seriesPosts.length - 1 ? seriesPosts[seriesIndex + 1] : null;
    }

    return {
      params: { slug: post.slug },
      props: { post, nextPost, prevPost, archivePosition: index + 1, archiveSize: sortedPosts.length },
    };
  });
}

const { post, nextPost, prevPost, archivePosition, archiveSize } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await post.render();

let sidecar: PostSidecar = { slug: '', themeIds: [], related: [] };
try {
  const slug = post.data.slug ?? post.slug;
  sidecar = (await import(`../../content/themes/${slug}.json`)).default;
} catch { /* no sidecar */ }

const dateStr = post.data.pubDate?.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC'
});

const ogDescription = post.data.description
  ?? post.body
      .replace(/^---[\s\S]*?---\n?/, '')
      .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
      .replace(/https?:\/\/\S+/g, '')
      .replace(/#+\s+/g, '')
      .replace(/\*\*(.*?)\*\*/g, '$1')
      .replace(/\*(.*?)\*/g, '$1')
      .replace(/`[^`]+`/g, '')
      .replace(/^\s*[-*+]\s+/gm, '')
      .replace(/\s{2,}/g, ' ')
      .replace(/\n+/g, ' ')
      .trim()
      .substring(0, 200)
      .replace(/\s+\S*$/, '') + '…';

const publishedTime = post.data.pubDate?.toISOString();
const canonicalUrl = `https://hologramthoughts.com/blog/${post.slug}/`;
const readingTime = remarkPluginFrontmatter?.readingTime;
const wordCount = remarkPluginFrontmatter?.wordCount ?? post.data.wordCount;
const isSeries = !!post.data.series;
const contentType = post.data.contentType ?? 'reflection';
const contentTypeLabel = contentType.charAt(0).toUpperCase() + contentType.slice(1);
const primaryCategory = post.data.categories?.[0];
const year = post.data.pubDate?.getUTCFullYear();
const categorySlugs: Record<string, string> = {
  'Dharma Writings': 'dharma-writings',
  'Creative Writing': 'creative-writing',
  'Consciousness & Philosophy': 'consciousness-philosophy',
  'Practice & Inner Life': 'practice-inner-life',
  'Other': 'other',
};
const jsonLd = blogPostingGraph({
  title: post.data.title,
  description: ogDescription,
  url: canonicalUrl,
  datePublished: publishedTime!,
  image: 'https://hologramthoughts.com/og-image.png',
  tags: post.data.tags,
  categories: post.data.categories,
  wordCount: remarkPluginFrontmatter?.wordCount ?? post.data.wordCount,
  readingTime,
});
---

<Layout
  wide
  title={`${post.data.title} — Hologram Thoughts`}
  description={ogDescription}
  ogType="article"
  publishedTime={publishedTime}
  tags={post.data.tags}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
>
  <ReadingProgress />

  <!-- Applies the saved scale before the prose paints, so a resized reader never sees a size flash -->
  <script is:inline>
    (() => {
      try {
        const v = parseFloat(localStorage.getItem('ht-story-scale') || '');
        if (v >= 0.9 && v <= 1.6) document.documentElement.style.setProperty('--story-scale', String(v));
      } catch {}
    })();
  </script>

  <article class:list={['post-shell', `post-${contentType}`]}>
    <header class="post-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <a class="archive-return" href={`/archive/#year-${year}`}>
        <span aria-hidden="true">←</span> archive / {year}
      </a>

      <div class="post-kicker">
        <span class="signal-dot" aria-hidden="true"></span>
        <span>{contentTypeLabel}</span>
        <span aria-hidden="true">/</span>
        <span>entry {String(archiveSize - archivePosition + 1).padStart(3, '0')}</span>
      </div>

      <h1>{post.data.title}</h1>
      {post.data.description && <p class="post-deck">{post.data.description}</p>}

      <div class="hero-status">
        <div class="post-meta">
          <span>{dateStr}</span>
          {readingTime && <span>{readingTime} min read</span>}
          {wordCount && <span>{wordCount.toLocaleString()} words</span>}
        </div>
        <p class="byline">
          <span class="tok-key">author</span><span class="tok-punct">:</span>
          <span class="tok-punct">"</span><span class="tok-string">Matthew Williamson</span><span class="tok-punct">"</span>
        </p>
      </div>
    </header>

    <div class="reading-layout">
      <aside class="reading-rail" aria-label="Post information">
        <div class="rail-sticky">
          <p class="rail-label">Filed under</p>
          <div class="rail-categories">
            {post.data.categories?.map(c => (
              <a href={`/categories/${categorySlugs[c] ?? 'other'}/`} style={`--category: ${categoryColor(c)}`}>{c}</a>
            ))}
          </div>
          <div class="rail-rule"></div>
          <p class="rail-label">Reading room</p>
          <div class="story-scale" role="group" aria-label="Story text size">
            <button type="button" class="scale-key" data-scale="dec" aria-label="Decrease story text size">−</button>
            <button type="button" class="scale-decl" data-scale="reset" aria-label="Reset story text size to 100%">
              <span class="tok-prop">Aa</span>
              <span class="tok-val" data-scale-readout>100%</span>
            </button>
            <button type="button" class="scale-key" data-scale="inc" aria-label="Increase story text size">+</button>
          </div>
          <a class="rail-archive" href="/archive/">find another entry <span aria-hidden="true">→</span></a>
        </div>
      </aside>

      <div class="manuscript">
        <TableOfContents headings={headings} />
        <div class="prose post-content">
          <Content />
        </div>
        <div class="end-mark" aria-label="End of post">
          <span></span><b>◇</b><span></span>
        </div>
        <ThemeChipStrip themeIds={sidecar.themeIds} />
        <RelatedPosts related={sidecar.related} />
      </div>

      <aside class="reading-aside" aria-hidden="true">
        <p>{String(year).slice(0, 2)}</p>
        <strong>{String(year).slice(2)}</strong>
        <span>hologram<br />thoughts</span>
      </aside>
    </div>
  </article>

  <footer class="post-exit">
    <p class="exit-label">{isSeries ? `Continue ${post.data.series}` : 'Move through the archive'}</p>
    <nav class="post-nav" aria-label="Adjacent posts">
      {prevPost ? (
        <a href={`/blog/${prevPost.slug}/`} class="post-nav-link older">
          <span>{isSeries ? '← Previous' : '← Older transmission'}</span>
          <strong>{prevPost.data.title}</strong>
          <small>{new Date(prevPost.data.pubDate).getUTCFullYear()}</small>
        </a>
      ) : <span class="post-nav-empty" />}
      {nextPost ? (
        <a href={`/blog/${nextPost.slug}/`} class="post-nav-link newer">
          <span>{isSeries ? 'Next →' : 'Newer transmission →'}</span>
          <strong>{nextPost.data.title}</strong>
          <small>{new Date(nextPost.data.pubDate).getUTCFullYear()}</small>
        </a>
      ) : <span class="post-nav-empty" />}
    </nav>
    <a class="all-entries" href="/archive/">Browse all {archiveSize} entries <span aria-hidden="true">↗</span></a>
  </footer>
</Layout>

<style>
  .post-shell {
    position: relative;
  }

  .post-hero {
    position: relative;
    isolation: isolate;
    min-height: 31rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2.5rem clamp(1.25rem, 5vw, 4.5rem) 3rem;
    margin: -1.5rem 0 4rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: 2px 2px 1.25rem 1.25rem;
    background:
      radial-gradient(circle at 78% 23%, color-mix(in oklch, var(--color-magenta) 18%, transparent), transparent 28%),
      radial-gradient(circle at 18% 82%, color-mix(in oklch, var(--color-blue) 15%, transparent), transparent 32%),
      linear-gradient(145deg, color-mix(in oklch, var(--color-surface) 70%, transparent), color-mix(in oklch, var(--color-bg) 92%, transparent));
    box-shadow: 0 30px 80px oklch(0 0 0 / 0.22);
  }

  .post-hero::before {
    content: "";
    position: absolute;
    z-index: -1;
    inset: 0;
    background: linear-gradient(90deg, transparent 0 64%, color-mix(in oklch, var(--color-cyan) 5%, transparent) 64% 64.1%, transparent 64.1%);
    pointer-events: none;
  }

  .post-hero::after {
    content: "";
    position: absolute;
    z-index: -1;
    left: clamp(1.25rem, 5vw, 4.5rem);
    bottom: 0;
    width: min(13rem, 30%);
    height: 1px;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-magenta), transparent);
    box-shadow: 0 0 16px color-mix(in oklch, var(--color-cyan) 55%, transparent);
  }

  .hero-grid {
    position: absolute;
    z-index: -2;
    inset: 0;
    opacity: 0.2;
    background-image:
      linear-gradient(var(--color-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--color-border) 1px, transparent 1px);
    background-size: 42px 42px;
    mask-image: linear-gradient(to bottom, black, transparent 82%);
  }

  .archive-return {
    position: absolute;
    top: 1.5rem;
    left: clamp(1.25rem, 5vw, 4.5rem);
    color: var(--color-ink-soft);
    text-decoration: none;
    font: 500 0.7rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .archive-return:hover { color: var(--color-cyan); }

  .post-kicker {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1.2rem;
    color: var(--color-ink-soft);
    font: 500 0.68rem/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .signal-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 12px color-mix(in oklch, var(--color-green) 70%, transparent);
  }

  .post-hero h1 {
    max-width: 15ch;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(3.35rem, 8vw, 7.6rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 0.88;
    text-wrap: balance;
    text-shadow: 0 0 38px color-mix(in oklch, var(--color-magenta-hot) 13%, transparent);
  }

  .post-deck {
    max-width: 55ch;
    margin-top: 1.5rem;
    color: var(--color-ink-soft);
    font: italic 1.15rem/1.55 var(--font-body);
  }

  .hero-status {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
    margin-top: 2.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-mono);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
    color: var(--color-ink-soft);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .post-meta span:not(:first-child)::before {
    content: "/";
    margin-right: 1.4rem;
    color: var(--color-ink-faint);
  }

  .byline {
    white-space: nowrap;
    font-size: 0.72rem;
    letter-spacing: 0.01em;
  }

  .tok-key { color: var(--color-magenta); }
  .tok-prop { color: var(--color-cyan); }
  .tok-punct { color: var(--color-ink-faint); }
  .tok-string { color: var(--color-green); font-weight: 500; }

  .reading-layout {
    display: grid;
    grid-template-columns: minmax(8.5rem, 0.72fr) minmax(0, 42rem) minmax(5rem, 0.45fr);
    justify-content: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .rail-sticky {
    position: sticky;
    top: 6.5rem;
    padding-top: 0.5rem;
  }

  .rail-label {
    margin-bottom: 0.8rem;
    color: var(--color-ink-faint);
    font: 500 0.64rem/1.4 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .rail-categories {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .rail-categories a {
    position: relative;
    padding-left: 0.75rem;
    color: var(--color-ink-soft);
    font: 0.78rem/1.4 var(--font-ui);
    text-decoration: none;
  }

  .rail-categories a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.48em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--category);
    box-shadow: 0 0 8px var(--category);
  }

  .rail-categories a:hover { color: var(--category); }

  .rail-rule {
    width: 3rem;
    height: 1px;
    margin: 1.5rem 0;
    background: var(--color-border-strong);
  }

  .story-scale {
    display: grid;
    grid-template-columns: 1.8rem auto 1.8rem;
    width: fit-content;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
  }

  .scale-key,
  .scale-decl {
    min-height: 1.8rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 5px;
    background: color-mix(in oklch, var(--color-surface) 68%, transparent);
    color: var(--color-ink-soft);
    font: inherit;
    cursor: pointer;
    transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
  }

  .scale-key { display: grid; place-items: center; }

  .scale-decl {
    display: flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.25rem 0.45rem;
    font-size: 0.64rem;
  }

  .scale-key:hover,
  .scale-decl:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
    background: color-mix(in oklch, var(--color-cyan) 8%, var(--color-surface));
  }

  .tok-val {
    min-width: 3em;
    color: var(--color-amber-bright);
    font-variant-numeric: tabular-nums;
  }

  .tok-val.flash { animation: scale-flash 0.45s var(--ease-grow); }

  @keyframes scale-flash {
    0% { color: var(--color-green); text-shadow: 0 0 10px var(--color-green); }
  }

  .rail-archive {
    display: block;
    max-width: 9rem;
    margin-top: 1.35rem;
    color: var(--color-ink-faint);
    font: 0.68rem/1.5 var(--font-mono);
    text-decoration: none;
  }

  .rail-archive:hover { color: var(--color-cyan); }

  .manuscript {
    min-width: 0;
    position: relative;
  }

  .post-content {
    font-size: calc(1.16rem * var(--story-scale, 1));
    line-height: 1.82;
    color: var(--color-ink);
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-weight: 450;
    letter-spacing: -0.025em;
    margin-top: 2.9rem;
    margin-bottom: 0.85rem;
    line-height: 1.18;
    scroll-margin-top: 7rem;
  }

  .post-content :global(h1) { font-size: 1.95em; }
  .post-content :global(h2) { font-size: 1.62em; }
  .post-content :global(h3) { font-size: 1.3em; }
  .post-content :global(h4) { font-size: 1.1em; }

  .post-content :global(h2)::before {
    content: "//";
    display: block;
    margin-bottom: 0.4rem;
    color: var(--color-magenta);
    font: 0.45em/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .post-content :global(p) {
    margin: 0 0 1.45em;
    line-height: inherit;
  }

  .post-content :global(blockquote) {
    margin: 2.4rem clamp(-1rem, -3vw, -2.5rem);
    padding: 1.25rem 1.5rem 1.25rem 1.75rem;
    border: 0;
    border-left: 2px solid var(--color-magenta);
    background: linear-gradient(90deg, color-mix(in oklch, var(--color-magenta) 9%, transparent), transparent 75%);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.1em;
    font-style: italic;
  }

  .post-content :global(blockquote p) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .post-content :global(em)     { font-style: italic; }
  .post-content :global(strong) { font-weight: 600; }

  .post-content :global(code) {
    background: color-mix(in oklch, var(--color-cyan) 12%, transparent);
    color: var(--color-amber-bright);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-size: 0.92em;
    font-family: var(--font-mono);
    border: 1px solid var(--color-border);
  }

  .post-content :global(pre) {
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    margin: 2rem 0;
    box-shadow: inset 3px 0 var(--color-cyan);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.4rem;
    line-height: 1.7;
  }

  .post-content :global(hr) {
    border: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border-strong), transparent);
    margin: 3.5rem 0;
  }

  .post-content :global(a) {
    color: var(--color-amber-bright);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease-grow);
  }

  .post-content :global(a:hover) {
    color: var(--color-cyan);
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 2rem 0;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-deep);
  }

  .post-poetry .post-content {
    max-width: 36rem;
    font-family: var(--font-display);
    font-size: calc(1.22rem * var(--story-scale, 1));
    line-height: 1.66;
  }

  .end-mark {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 4.5rem 0 0;
    color: var(--color-magenta);
  }

  .end-mark span {
    height: 1px;
    flex: 1;
    background: linear-gradient(90deg, transparent, var(--color-border-strong));
  }

  .end-mark span:last-child { transform: scaleX(-1); }
  .end-mark b { font-size: 0.7rem; text-shadow: 0 0 12px var(--color-magenta); }

  .reading-aside {
    position: sticky;
    top: 6.5rem;
    padding-top: 0.25rem;
    color: var(--color-ink-faint);
    font-family: var(--font-mono);
    text-align: right;
  }

  .reading-aside p,
  .reading-aside strong {
    display: block;
    margin: 0;
    font-size: clamp(2.5rem, 4vw, 4.5rem);
    font-weight: 400;
    line-height: 0.72;
    letter-spacing: -0.08em;
  }

  .reading-aside strong {
    color: color-mix(in oklch, var(--color-magenta) 45%, var(--color-bg));
  }

  .reading-aside span {
    display: block;
    margin-top: 1rem;
    font-size: 0.58rem;
    line-height: 1.5;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .post-exit {
    margin-top: 6rem;
    padding: clamp(1.5rem, 4vw, 3rem);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    background:
      linear-gradient(135deg, color-mix(in oklch, var(--color-blue) 7%, transparent), transparent 44%),
      color-mix(in oklch, var(--color-surface) 48%, transparent);
  }

  .exit-label {
    margin-bottom: 1.25rem;
    color: var(--color-magenta);
    font: 500 0.68rem/1 var(--font-mono);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--color-border-strong);
    border: 1px solid var(--color-border-strong);
    border-radius: 0.7rem;
    overflow: hidden;
  }

  .post-nav-link {
    min-height: 10rem;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 1.5rem;
    background: color-mix(in oklch, var(--color-bg) 93%, transparent);
    color: var(--color-ink);
    text-decoration: none;
    transition: background var(--dur-med) var(--ease-grow);
  }

  .post-nav-link:hover {
    background: color-mix(in oklch, var(--color-blue) 8%, var(--color-bg));
    color: var(--color-cyan);
  }

  .post-nav-link > span {
    color: var(--color-ink-faint);
    font: 0.65rem/1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
