---
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import ThemeChipStrip from '../../components/ThemeChipStrip.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { blogPostingGraph } from '../../utils/jsonld';
import { categoryColor } from '../../utils/category-color';
import { categorySlug, CONTENT_TYPE_LABEL, type ContentType } from '../../utils/categories';
import { publishedPosts, routeSlug, urlOf, sidecarFor, themeNamesFor } from '../../utils/posts';
import { shouldShowDeck, metaDescription } from '../../utils/deck';

export async function getStaticPaths() {
  const posts = await publishedPosts(); // newest first
  return posts.map((post, index) => {
    const older = posts[index + 1] ?? null;
    const newer = posts[index - 1] ?? null;
    let seriesParts: { title: string; url: string; order: number }[] = [];
    if (post.data.series) {
      seriesParts = posts
        .filter((p) => p.data.series === post.data.series && p.data.seriesOrder !== undefined)
        .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
        .map((p) => ({ title: p.data.title, url: urlOf(p), order: p.data.seriesOrder! }));
    }
    return {
      params: { slug: routeSlug(post) },
      props: { post, older, newer, seriesParts, entryNumber: posts.length - index, archiveSize: posts.length },
    };
  });
}

const { post, older, newer, seriesParts, entryNumber, archiveSize } = Astro.props;
const { Content, remarkPluginFrontmatter, headings } = await post.render();

const SITE = 'https://hologramthoughts.com';
const sidecar = sidecarFor(post);
const themeNames = themeNamesFor(post);
const url = urlOf(post);
const canonicalUrl = `${SITE}${url}`;
const ogImage = `${SITE}/og/${routeSlug(post)}.png`;

const pub: Date = post.data.pubDate;
const dateStr = pub.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const year = pub.getUTCFullYear();
const readingTime: number | undefined = remarkPluginFrontmatter?.readingTime;
const wordCount: number | undefined = remarkPluginFrontmatter?.wordCount ?? post.data.wordCount;
const contentType = (post.data.contentType ?? 'reflection') as ContentType;
const typeLabel = CONTENT_TYPE_LABEL[contentType] ?? contentType;
const categories: string[] = (post.data.categories ?? []).filter((c: string) => c !== 'uncategorized');

const showDeck = shouldShowDeck(post.data.description, post.body);
const description = metaDescription(post.data.description, post.body);

const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const hasToc = tocItems.length >= 3;

const seriesIndex = seriesParts.findIndex((p) => p.url === url);
const inSeries = seriesIndex >= 0;
const seriesNextPart = inSeries ? seriesParts[seriesIndex + 1] : undefined;
const seriesNext = seriesNextPart
  ? { title: seriesNextPart.title, url: seriesNextPart.url, order: seriesIndex + 2, total: seriesParts.length, series: post.data.series! }
  : null;

const jsonLd = blogPostingGraph({
  title: post.data.title,
  description,
  url: canonicalUrl,
  datePublished: pub.toISOString(),
  image: ogImage,
  imageAlt: `${post.data.title} — Hologram Thoughts`,
  tags: [...new Set([...(post.data.tags ?? []), ...themeNames])],
  categories,
  wordCount,
  readingTime,
  genre: typeLabel,
  about: themeNames,
  series: inSeries ? { name: post.data.series!, position: seriesIndex + 1 } : undefined,
});
---

<Layout
  wide
  title={`${post.data.title} — Hologram Thoughts`}
  description={description}
  ogType="article"
  ogImage={ogImage}
  ogImageAlt={`${post.data.title} — ${typeLabel.toLowerCase()} by Matthew Williamson`}
  publishedTime={pub.toISOString()}
  section={categories[0]}
  tags={[...new Set([...(post.data.tags ?? []), ...themeNames])]}
  canonicalUrl={canonicalUrl}
  jsonLd={jsonLd}
  reading={{ title: post.data.title }}
>
  <!-- Applies the saved text size before the prose paints, so a resized reader never sees a jump -->
  <script is:inline>
    (() => {
      try {
        const v = parseFloat(localStorage.getItem('ht-story-scale') || '');
        if (v >= 0.9 && v <= 1.6) document.documentElement.style.setProperty('--story-scale', String(v));
      } catch {}
    })();
  </script>

  <article class:list={['post', `post-${contentType}`, hasToc && 'has-toc']}>
    <header class="post-head">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/archive/">archive</a><span aria-hidden="true">/</span><a href={`/archive/#year-${year}`}>{year}</a><span aria-hidden="true">/</span><span class="crumb-here">entry {String(entryNumber).padStart(3, '0')} of {archiveSize}</span>
      </nav>

      <p class="kicker post-kicker">
        <span class="signal-dot" aria-hidden="true"></span>
        <span>{typeLabel}</span>
        {inSeries && <><span aria-hidden="true">·</span><span class="kicker-series">{post.data.series}, part {seriesIndex + 1} of {seriesParts.length}</span></>}
      </p>

      <h1 data-reading-start>{post.data.title}</h1>
      {showDeck && <p class="deck">{post.data.description}</p>}

      <div class="meta-line">
        <time datetime={pub.toISOString()}>{dateStr}</time>
        {readingTime && <span>{readingTime} min read</span>}
        {wordCount && <span>{wordCount.toLocaleString()} words</span>}
        <span class="byline"><span class="tok-key">author</span><span class="tok-punct">: </span><span class="tok-string">Matthew Williamson</span></span>
      </div>

      <div class="toolbar">
        {categories.length > 0 && (
          <ul class="cats" aria-label="Categories">
            {categories.map((c) => (
              <li><a href={`/categories/${categorySlug(c)}/`} style={`--category: ${categoryColor(c)}`}>{c}</a></li>
            ))}
          </ul>
        )}
        <div class="tools">
          <div class="story-scale" role="group" aria-label="Text size">
            <button type="button" data-scale="dec" aria-label="Smaller text">A−</button>
            <button type="button" data-scale="reset" aria-label="Reset text size"><span data-scale-readout>100%</span></button>
            <button type="button" data-scale="inc" aria-label="Larger text">A+</button>
          </div>
          <button type="button" class="share" data-share={canonicalUrl} data-share-title={post.data.title}>
            <span data-share-label>share</span>
          </button>
        </div>
      </div>

      {inSeries && (
        <details class="series-box">
          <summary>
            <span class="sb-label">{post.data.series}</span>
            <span class="sb-count">part {seriesIndex + 1} of {seriesParts.length} · all parts</span>
          </summary>
          <ol>
            {seriesParts.map((p, i) => (
              <li class:list={[i === seriesIndex && 'current']}>
                {i === seriesIndex
                  ? <span aria-current="page"><b>{String(i + 1).padStart(2, '0')}</b>{p.title}</span>
                  : <a href={p.url}><b>{String(i + 1).padStart(2, '0')}</b>{p.title}</a>}
              </li>
            ))}
          </ol>
        </details>
      )}
    </header>

    <div class="post-grid">
      {hasToc && (
        <aside class="rail">
          <TableOfContents headings={headings} variant="rail" />
        </aside>
      )}
      <div class="post-body" data-reading-body data-minutes={readingTime ?? 0}>
        {hasToc && <div class="toc-inline-wrap"><TableOfContents headings={headings} variant="inline" /></div>}
        <div class="post-content">
          <Content />
        </div>

        <div class="end-mark" data-reading-end aria-hidden="true"><span></span><b>◇</b><span></span></div>

        <ThemeChipStrip themeIds={sidecar.themeIds} />
        <RelatedPosts related={sidecar.related} seriesNext={seriesNext} />

        <nav class="post-nav" aria-label="Older and newer posts">
          {older && (
            <a href={urlOf(older)} rel="prev" class="pn older">
              <span class="pn-dir">← older</span>
              <span class="pn-title">{older.data.title}</span>
              <span class="pn-year">{older.data.pubDate.getUTCFullYear()}</span>
            </a>
          )}
          {newer && (
            <a href={urlOf(newer)} rel="next" class="pn newer">
              <span class="pn-dir">newer →</span>
              <span class="pn-title">{newer.data.title}</span>
              <span class="pn-year">{newer.data.pubDate.getUTCFullYear()}</span>
            </a>
          )}
        </nav>
        <p class="all-entries"><a href="/archive/">browse all {archiveSize} entries →</a></p>
      </div>
    </div>
  </article>
</Layout>

<style>
  /* One grid for header + body: a centered text column with an optional left rail. */
  .post {
    --col: min(100%, 41rem);
    --rail: 13.5rem;
  }
  .post-head, .post-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--col) minmax(0, 1fr);
    column-gap: var(--space-xl);
  }
  .post-head > * { grid-column: 2 / 4; max-width: 52rem; }
  .post-head > .deck, .post-head > .toolbar, .post-head > .series-box, .post-head > .meta-line { grid-column: 2; max-width: none; }

  .post-head {
    padding: var(--space-s) 0 var(--space-l);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: var(--space-m);
    color: var(--color-ink-faint);
    font: var(--step--2)/1.4 var(--font-mono);
    letter-spacing: 0.06em;
  }
  .crumbs a { color: var(--color-ink-soft); text-decoration: none; }
  .crumbs a:hover { color: var(--color-cyan); }
  .crumb-here { color: var(--color-ink-faint); }

  .post-kicker { margin-bottom: var(--space-xs); }
  .kicker-series { color: var(--color-green); text-transform: none; letter-spacing: 0.04em; }
  .signal-dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--color-green);
    box-shadow: 0 0 12px color-mix(in oklch, var(--color-green) 70%, transparent);
  }

  h1 {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 1.6rem + 3.3vw, 4.6rem);
    font-weight: 480;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
  }
  .deck {
    margin: var(--space-s) 0 0;
    color: var(--color-ink-soft);
    font: italic var(--step-1)/1.5 var(--font-body);
    text-wrap: pretty;
  }

  .meta-line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.1rem;
    margin-top: var(--space-m);
    color: var(--color-ink-soft);
    font: var(--step--2)/1.5 var(--font-mono);
    letter-spacing: 0.04em;
  }
  .meta-line > time, .meta-line > span:not(.byline) { color: var(--color-amber-bright); }
  .byline { margin-left: auto; white-space: nowrap; }
  .tok-key { color: var(--color-magenta); }
  .tok-punct { color: var(--color-ink-faint); }
  .tok-string { color: var(--color-green); }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1rem;
    margin-top: var(--space-s);
    padding: 0.55rem 0;
    border-block: 1px solid var(--color-border);
  }
  .cats { display: flex; flex-wrap: wrap; gap: 0.35rem 1rem; margin: 0; padding: 0; list-style: none; }
  .cats a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 32px;
    color: var(--color-ink-soft);
    font: var(--step--1)/1 var(--font-ui);
    text-decoration: none;
  }
  .cats a::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--category);
    box-shadow: 0 0 8px var(--category);
  }
  .cats a:hover { color: var(--category); }
  .tools { display: flex; align-items: center; gap: 0.5rem; margin-left: auto; }
  .story-scale { display: flex; gap: 0.25rem; }
  .story-scale button, .share {
    min-width: 2.2rem;
    min-height: 32px;
    padding: 0 0.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    background: color-mix(in oklch, var(--color-surface) 55%, transparent);
    color: var(--color-ink-soft);
    font: var(--step--2)/1 var(--font-mono);
    cursor: pointer;
    transition: color var(--dur-fast), border-color var(--dur-fast), background var(--dur-fast);
  }
  [data-scale-readout] { color: var(--color-amber-bright); font-variant-numeric: tabular-nums; }
  .story-scale button:hover, .share:hover {
    color: var(--color-cyan);
    border-color: var(--color-cyan);
    background: color-mix(in oklch, var(--color-cyan) 8%, var(--color-surface));
  }

  .series-box {
    margin-top: var(--space-s);
    border: 1px solid color-mix(in oklch, var(--color-green) 30%, var(--color-border));
    border-radius: 10px;
    background: color-mix(in oklch, var(--color-green) 5%, transparent);
  }
  .series-box summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.25rem 1rem;
    min-height: 46px;
    padding: 0.35rem 1rem;
    cursor: pointer;
    list-style: none;
  }
  .series-box summary::-webkit-details-marker { display: none; }
  .sb-label { color: var(--color-ink); font: 480 var(--step-0)/1.2 var(--font-display); }
  .sb-count { color: var(--color-green); font: var(--step--2) var(--font-mono); }
  .sb-count::after { content: " +"; }
  .series-box[open] .sb-count::after { content: " −"; }
  .series-box ol { margin: 0; padding: 0 0.6rem 0.6rem; list-style: none; }
  .series-box li > * {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.5rem 0.4rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    font: var(--step--1)/1.35 var(--font-ui);
    text-decoration: none;
  }
  .series-box li a:hover { color: var(--color-cyan); }
  .series-box li.current > * { color: var(--color-ink); }
  .series-box b { color: var(--color-amber-bright); font: 400 var(--step--2) var(--font-mono); }
  .series-box li.current b { color: var(--color-green); }

  /* Body */
  .rail { grid-column: 1; justify-self: end; width: var(--rail); padding-top: 0.35rem; }
  .post-body { grid-column: 2; min-width: 0; }
  .toc-inline-wrap { display: none; }

  .post-content {
    color: var(--color-ink);
    font-family: var(--font-body);
    font-size: calc(clamp(1.08rem, 1.02rem + 0.28vw, 1.22rem) * var(--story-scale, 1));
    line-height: 1.76;
    font-kerning: normal;
    font-variant-ligatures: common-ligatures;
    hanging-punctuation: first;
    text-wrap: pretty;
  }
  .post-content > :global(:first-child) { margin-top: 0; }
  .post-content :global(p) { margin: 0 0 1.3em; }

  .post-content :global(:is(h1, h2, h3, h4, h5, h6)) {
    position: relative;
    margin: 2.4em 0 0.7em;
    color: var(--color-ink);
    font-family: var(--font-display);
    font-weight: 480;
    letter-spacing: -0.02em;
    line-height: 1.2;
    text-wrap: balance;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }
  .post-content :global(h1) { font-size: 1.85em; }
  .post-content :global(h2) { font-size: 1.55em; }
  .post-content :global(h3) { font-size: 1.25em; }
  .post-content :global(h4) { font-size: 1.08em; }
  .post-content :global(h2)::before {
    content: "//";
    display: block;
    margin-bottom: 0.35rem;
    color: var(--color-magenta);
    font: 0.42em/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .post-content :global(blockquote) {
    margin: 2em 0;
    padding: 0.9em 1.2em 0.9em 1.3em;
    border-left: 2px solid var(--color-magenta);
    background: linear-gradient(90deg, color-mix(in oklch, var(--color-magenta) 8%, transparent), transparent 80%);
    color: var(--color-ink);
    font-family: var(--font-display);
    font-size: 1.06em;
    font-style: italic;
    line-height: 1.6;
  }
  .post-content :global(blockquote p:last-child) { margin-bottom: 0; }
  .post-content :global(strong) { font-weight: 600; color: color-mix(in oklch, var(--color-ink) 92%, white); }

  .post-content :global(a) {
    color: var(--color-amber-bright);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklch, var(--color-amber-bright) 40%, transparent);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .post-content :global(a:hover) { color: var(--color-cyan); text-decoration-color: var(--color-cyan); }

  .post-content :global(:not(pre) > code) {
    padding: 0.1em 0.35em;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: color-mix(in oklch, var(--color-cyan) 10%, transparent);
    color: var(--color-amber-bright);
    font: 0.86em var(--font-mono);
  }
  .post-content :global(pre) {
    margin: 1.8em 0;
    padding: 1.1em 1.25em;
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg-soft) !important;
    box-shadow: inset 2px 0 var(--color-cyan);
    font-size: 0.8em;
    line-height: 1.6;
  }
  .post-content :global(pre code) { font-family: var(--font-mono); }

  .post-content :global(:is(ul, ol)) { margin: 0 0 1.3em; padding-left: 1.4em; }
  .post-content :global(li) { margin-bottom: 0.45em; padding-left: 0.2em; }
  .post-content :global(ul > li::marker) { color: var(--color-magenta); }
  .post-content :global(ol > li::marker) { color: var(--color-amber-bright); font-family: var(--font-mono); font-size: 0.85em; }

  .post-content :global(hr) {
    height: auto;
    margin: 2.8em 0;
    border: 0;
    background: none;
    text-align: center;
  }
  .post-content :global(hr)::after {
    content: "· · ·";
    color: var(--color-ink-faint);
    font: 1rem var(--font-mono);
    letter-spacing: 0.5em;
  }

  .post-content :global(img), .post-content :global(video), .post-content :global(iframe) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 2em auto;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .post-content :global(table) {
    width: 100%;
    margin: 1.8em 0;
    border-collapse: collapse;
    font: var(--step--1)/1.5 var(--font-ui);
    display: block;
    overflow-x: auto;
  }
  .post-content :global(:is(th, td)) { padding: 0.5em 0.75em; border-bottom: 1px solid var(--color-border); text-align: left; }
  .post-content :global(th) { color: var(--color-magenta); font-weight: 500; }
  .post-content :global(.footnotes) { margin-top: 3em; padding-top: 1em; border-top: 1px solid var(--color-border); font-size: 0.85em; color: var(--color-ink-soft); }
  .post-content :global(sup a) { text-decoration: none; font-family: var(--font-mono); font-size: 0.8em; }

  /* Poetry: display serif, narrower measure, lines breathe. */
  .post-poetry .post-content {
    max-width: 34rem;
    font-family: var(--font-display);
    font-size: calc(clamp(1.1rem, 1.04rem + 0.3vw, 1.26rem) * var(--story-scale, 1));
    line-height: 1.7;
    text-wrap: wrap;
  }
  .post-poetry .post-content :global(p) { margin-bottom: 1.5em; }

  .end-mark {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: var(--space-xl) 0 0;
    color: var(--color-magenta);
  }
  .end-mark span { height: 1px; flex: 1; background: linear-gradient(90deg, transparent, var(--color-border-strong)); }
  .end-mark span:last-child { transform: scaleX(-1); }
  .end-mark b { font-size: 0.7rem; text-shadow: 0 0 12px var(--color-magenta); }

  .post-nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: var(--space-xs);
    margin-top: var(--space-l);
  }
  .pn {
    display: grid;
    gap: 0.3rem;
    padding: var(--space-s);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color var(--dur-fast), background var(--dur-fast);
  }
  .pn:hover { border-color: color-mix(in oklch, var(--color-cyan) 50%, transparent); background: color-mix(in oklch, var(--color-blue) 6%, transparent); }
  .pn.newer { text-align: right; }
  .pn-dir { color: var(--color-ink-faint); font: var(--step--2)/1 var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; }
  .pn-title { font: 480 var(--step-1)/1.2 var(--font-display); text-wrap: balance; }
  .pn:hover .pn-title { color: var(--color-cyan); }
  .pn-year { color: var(--color-amber-bright); font: var(--step--2)/1 var(--font-mono); }
  .all-entries { margin: var(--space-m) 0 0; text-align: center; }
  .all-entries a { color: var(--color-ink-soft); font: var(--step--2)/1 var(--font-mono); text-decoration: none; }
  .all-entries a:hover { color: var(--color-cyan); }

  @media (max-width: 1180px) {
    .post-head, .post-grid { grid-template-columns: minmax(0, 1fr) var(--col) minmax(0, 1fr); column-gap: 0; }
    .rail { display: none; }
    .toc-inline-wrap { display: block; }
    .post-head > * { grid-column: 2; max-width: none; }
  }
  @media (max-width: 640px) {
    .post-head { padding-top: 0; padding-bottom: var(--space-m); }
    .crumbs { margin-bottom: var(--space-s); }
    .byline { margin-left: 0; }
    .toolbar { padding: 0.45rem 0; }
    .tools { margin-left: 0; width: 100%; justify-content: space-between; }
    .post-content :global(blockquote) { margin-inline: 0; padding-inline: 1em 0.5em; }
  }

  @media print {
    .crumbs, .toolbar, .series-box, .rail, .toc-inline-wrap, .post-nav, .all-entries, .end-mark { display: none !important; }
    .post-head, .post-grid { display: block; }
    .post-content { font-size: 11.5pt; }
  }
</style>

<script>
  // Text size — persisted per reader.
  const KEY = 'ht-story-scale';
  const MIN = 0.9, MAX = 1.6, STEP = 0.1;
  let scale = 1;
  try {
    const saved = parseFloat(localStorage.getItem(KEY) || '');
    if (saved >= MIN && saved <= MAX) scale = saved;
  } catch {}
  const readout = document.querySelector<HTMLElement>('[data-scale-readout]');
  const paint = () => { if (readout) readout.textContent = `${Math.round(scale * 100)}%`; };
  paint();
  document.querySelectorAll<HTMLButtonElement>('[data-scale]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const action = btn.dataset.scale;
      scale = action === 'inc' ? scale + STEP : action === 'dec' ? scale - STEP : 1;
      scale = Math.min(MAX, Math.max(MIN, Math.round(scale * 10) / 10));
      document.documentElement.style.setProperty('--story-scale', String(scale));
      paint();
      try { localStorage.setItem(KEY, String(scale)); } catch {}
    });
  });

  // Share — native sheet where available, otherwise copy the link.
  const share = document.querySelector<HTMLButtonElement>('[data-share]');
  const label = share?.querySelector<HTMLElement>('[data-share-label]');
  share?.addEventListener('click', async () => {
    const url = share.dataset.share!;
    const title = share.dataset.shareTitle ?? document.title;
    const coarse = matchMedia('(pointer: coarse)').matches;
    try {
      if (coarse && navigator.share) { await navigator.share({ title, url }); return; }
      await navigator.clipboard.writeText(url);
      if (label) { label.textContent = 'link copied'; setTimeout(() => { label.textContent = 'share'; }, 1800); }
    } catch { /* dismissed */ }
  });

  // Contents rail — highlight the last section heading above the reading line.
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]');
  if (links.length) {
    const pairs = [...links]
      .map((a) => ({ a, h: document.getElementById(a.dataset.tocLink!) }))
      .filter((p): p is { a: HTMLAnchorElement; h: HTMLElement } => !!p.h);
    let current: HTMLAnchorElement | undefined;
    let queued = false;
    const update = () => {
      queued = false;
      const line = innerHeight * 0.3;
      let next: HTMLAnchorElement | undefined;
      for (const p of pairs) {
        if (p.h.getBoundingClientRect().top <= line) next = p.a;
        else break;
      }
      if (next === current) return;
      current?.classList.remove('is-active');
      next?.classList.add('is-active');
      current = next;
    };
    addEventListener('scroll', () => { if (!queued) { queued = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }
</script>
