---
import Layout from '../layouts/Layout.astro';
import { publishedPosts, themes } from '../utils/posts';

const posts = await publishedPosts();
const oldestYear = posts.at(-1)!.data.pubDate.getUTCFullYear();
const newestYear = posts[0].data.pubDate.getUTCFullYear();
const topThreads = [...themes].sort((a, b) => b.postCount - a.postCount).slice(0, 8);
---

<Layout wide title="Search — Hologram Thoughts" description={`Search every word of ${posts.length} posts written ${oldestYear}–${newestYear} on Hologram Thoughts.`}>
  <section class="search-top" aria-labelledby="search-title">
    <p class="kicker"><span class="dot" aria-hidden="true"></span>full-text search · {posts.length} entries · {oldestYear}—{newestYear}</p>
    <h1 id="search-title">Find the line <em>you remember.</em></h1>

    <div class="query-field">
      <label for="search-input" class="visually-hidden">Search every word of the archive</label>
      <span class="query-prompt" aria-hidden="true">›</span>
      <input
        type="search"
        id="search-input"
        placeholder="a person, an image, a practice, a half-remembered phrase…"
        autocomplete="off"
        spellcheck="false"
        enterkeyhint="search"
        aria-controls="search-results"
      />
      <kbd aria-hidden="true">esc</kbd>
    </div>

    <div class="suggest" aria-label="Suggested searches">
      <span>try</span>
      {['impermanence', 'dreams', 'artificial intelligence', 'compassion', 'fatherhood', 'Tibet'].map((q) => (
        <button type="button" data-query={q}>{q}</button>
      ))}
    </div>
  </section>

  <section class="workspace" aria-labelledby="results-heading">
    <header class="toolbar">
      <h2 id="results-heading" aria-live="polite">Type to search every word</h2>
      <div class="controls" hidden data-controls>
        <div class="types" role="group" aria-label="Filter by kind of writing">
          <button type="button" aria-pressed="true" data-type="all">All</button>
          <button type="button" aria-pressed="false" data-type="poetry">Poetry</button>
          <button type="button" aria-pressed="false" data-type="story">Stories</button>
          <button type="button" aria-pressed="false" data-type="article">Articles</button>
          <button type="button" aria-pressed="false" data-type="reflection">Reflections</button>
        </div>
        <label class="sort">
          <span>sort</span>
          <select id="sort-results">
            <option value="relevance">relevance</option>
            <option value="newest">newest</option>
            <option value="oldest">oldest</option>
          </select>
        </label>
      </div>
    </header>

    <div id="search-results">
      <div class="idle">
        <p class="section-label"><span>or follow a thread</span></p>
        <ul class="thread-links">
          {topThreads.map((t) => (
            <li><a href={`/themes/${t.id}/`}><span>{t.name}</span><b>{t.postCount}</b></a></li>
          ))}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  .search-top { padding: var(--space-s) 0 var(--space-m); }
  .kicker { margin-bottom: var(--space-xs); }
  .dot { width: 0.42rem; height: 0.42rem; border-radius: 50%; background: var(--color-green); box-shadow: 0 0 12px var(--color-green); }
  h1 {
    margin: 0 0 var(--space-m);
    font-size: var(--step-4);
    font-weight: 480;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  h1 em { color: var(--color-blue); }

  .query-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 4rem;
    padding: 0 1.1rem;
    border: 1px solid color-mix(in oklch, var(--color-cyan) 45%, var(--color-border-strong));
    border-radius: 12px;
    background: color-mix(in oklch, var(--color-bg-soft) 85%, transparent);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--color-cyan) 6%, transparent), 0 20px 50px oklch(0 0 0 / 0.25);
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .query-field:focus-within {
    border-color: var(--color-cyan);
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--color-cyan) 14%, transparent), 0 20px 50px oklch(0 0 0 / 0.25);
  }
  .query-prompt { color: var(--color-green); font: 1.5rem var(--font-mono); }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--color-ink);
    font: var(--step-2)/1.2 var(--font-display);
  }
  input::placeholder { color: var(--color-ink-faint); font-size: 0.8em; }
  input::-webkit-search-cancel-button { display: none; }
  kbd {
    padding: 0.15rem 0.4rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 5px;
    color: var(--color-ink-faint);
    font: 0.65rem var(--font-mono);
  }

  .suggest { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; margin-top: var(--space-s); }
  .suggest > span { margin-right: 0.3rem; color: var(--color-ink-faint); font: var(--step--2) var(--font-mono); }
  .suggest button {
    min-height: 32px;
    padding: 0 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    font: var(--step--1)/1 var(--font-ui);
    cursor: pointer;
  }
  .suggest button:hover { color: var(--color-cyan); border-color: color-mix(in oklch, var(--color-cyan) 50%, transparent); }

  .workspace { margin-top: var(--space-m); }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border-strong);
  }
  .toolbar h2 { margin: 0; font-size: var(--step-2); }
  .controls { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; }
  .controls[hidden] { display: none; }
  .types { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .types button {
    min-height: 32px;
    padding: 0 0.65rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: transparent;
    color: var(--color-ink-soft);
    font: var(--step--1)/1 var(--font-ui);
    cursor: pointer;
  }
  .types button[aria-pressed='true'] { background: var(--color-cyan); border-color: var(--color-cyan); color: var(--color-bg); }
  .sort { display: flex; align-items: center; gap: 0.4rem; color: var(--color-ink-faint); font: var(--step--2) var(--font-mono); }
  .sort select {
    min-height: 32px;
    padding: 0 0.4rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    background: var(--color-bg-soft);
    color: var(--color-ink);
    font: var(--step--1) var(--font-ui);
  }

  .idle { padding-top: var(--space-m); }
  .thread-links { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  .thread-links a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    color: var(--color-ink);
    font: var(--step-0)/1.2 var(--font-display);
    text-decoration: none;
  }
  .thread-links a:hover { border-color: color-mix(in oklch, var(--color-cyan) 50%, transparent); color: var(--color-cyan); }
  .thread-links b { color: var(--color-amber-bright); font: 400 var(--step--2) var(--font-mono); }

  #search-results :global(.results-list) { margin: 0; padding: 0; list-style: none; }
  #search-results :global(.result) { border-bottom: 1px solid var(--color-border); }
  #search-results :global(.result a) {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0.4rem var(--space-s);
    padding: 1rem 0.5rem;
    color: var(--color-ink);
    text-decoration: none;
  }
  #search-results :global(.result a:hover),
  #search-results :global(.result a:focus-visible) { background: linear-gradient(90deg, color-mix(in oklch, var(--color-blue) 7%, transparent), transparent 80%); }
  #search-results :global(.r-year) { color: var(--color-amber-bright); font: var(--step--2)/1.6 var(--font-mono); }
  #search-results :global(.r-body) { display: flex; flex-direction: column; gap: 0.35rem; min-width: 0; }
  #search-results :global(.r-title) { font: 480 var(--step-1)/1.25 var(--font-display); }
  #search-results :global(.result a:hover .r-title) { color: var(--color-cyan); }
  #search-results :global(.r-excerpt) { margin: 0; color: var(--color-ink-soft); font-size: var(--step--1); line-height: 1.55; }
  #search-results :global(.r-meta) { color: var(--color-ink-faint); font: var(--step--2)/1.4 var(--font-mono); }
  #search-results :global(.r-type) { color: var(--color-magenta); text-transform: uppercase; letter-spacing: 0.06em; }
  #search-results :global(.note) { padding: var(--space-m) 0; color: var(--color-ink-soft); }
  #search-results :global(.note strong) { display: block; margin-bottom: 0.35rem; color: var(--color-ink); font: var(--step-2)/1.2 var(--font-display); font-weight: 480; }
  #search-results :global(.note a) { color: var(--color-cyan); }

  @media (max-width: 560px) {
    .query-field { min-height: 3.4rem; padding: 0 0.8rem; }
    kbd { display: none; }
    #search-results :global(.result a) { grid-template-columns: 1fr; }
  }
</style>

<script>
  type Doc = { title: string; url: string; categories: string[]; tags: string[]; description: string; content: string; date: string; year: number; type: string };

  const input = document.querySelector<HTMLInputElement>('#search-input')!;
  const root = document.querySelector<HTMLElement>('#search-results')!;
  const heading = document.querySelector<HTMLElement>('#results-heading')!;
  const controls = document.querySelector<HTMLElement>('[data-controls]');
  const sortSelect = document.querySelector<HTMLSelectElement>('#sort-results')!;
  const typeButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-type]')];
  const idle = [...root.childNodes].map((n) => n.cloneNode(true));

  const normalize = (v: string) => v.toLowerCase().normalize('NFKD').replace(/[̀-ͯ]/g, '');
  let docs: (Doc & { hay: string; nTitle: string; nDesc: string; nCats: string; nTags: string; nContent: string })[] | null = null;
  let loading: Promise<void> | null = null;
  let activeType = 'all';
  let timer = 0;

  function load() {
    loading ??= fetch('/search-full.json')
      .then((r) => r.json())
      .then((raw: Doc[]) => {
        docs = raw.map((d) => {
          const nContent = normalize(d.content);
          const nTitle = normalize(d.title);
          const nDesc = normalize(d.description);
          const nCats = normalize(d.categories.join(' '));
          const nTags = normalize(d.tags.join(' '));
          return { ...d, nTitle, nDesc, nCats, nTags, nContent, hay: [nTitle, nDesc, nCats, nTags, nContent].join(' ') };
        });
      });
    return loading;
  }

  // Per-character fold that never changes string length, so match offsets
  // line up with the original text (NFKD alone expands e.g. "…" to "...").
  const foldSameLength = (text: string) =>
    [...text].map((c) => { const f = normalize(c); return f.length === c.length ? f : c.toLowerCase(); }).join('');

  function highlight(parent: HTMLElement, text: string, terms: string[]) {
    const lower = foldSameLength(text);
    const ranges: [number, number][] = [];
    for (const term of terms) {
      let from = 0;
      while (from < lower.length) {
        const i = lower.indexOf(term, from);
        if (i < 0) break;
        ranges.push([i, i + term.length]);
        from = i + term.length;
      }
    }
    ranges.sort((a, b) => a[0] - b[0]);
    let cursor = 0;
    for (const [s, e] of ranges) {
      if (s < cursor) continue;
      if (s > cursor) parent.append(text.slice(cursor, s));
      const m = document.createElement('mark');
      m.textContent = text.slice(s, e);
      parent.append(m);
      cursor = e;
    }
    if (cursor < text.length) parent.append(text.slice(cursor));
  }

  function excerpt(d: NonNullable<typeof docs>[number], terms: string[]) {
    if (d.description && terms.some((t) => d.nDesc.includes(t))) return d.description;
    const positions = terms.map((t) => d.nContent.indexOf(t)).filter((p) => p >= 0);
    if (!positions.length) return d.description || d.content.slice(0, 200);
    const at = Math.min(...positions);
    let start = Math.max(0, at - 80);
    let end = Math.min(d.content.length, at + 180);
    if (start > 0) { const sp = d.content.indexOf(' ', start); if (sp > -1 && sp < at) start = sp + 1; }
    if (end < d.content.length) { const sp = d.content.lastIndexOf(' ', end); if (sp > at) end = sp; }
    return `${start > 0 ? '…' : ''}${d.content.slice(start, end).trim()}${end < d.content.length ? '…' : ''}`;
  }

  function score(d: NonNullable<typeof docs>[number], terms: string[]) {
    let s = 0;
    for (const t of terms) {
      if (d.nTitle === t) s += 30; else if (d.nTitle.includes(t)) s += 14;
      if (d.nCats.includes(t)) s += 9;
      if (d.nTags.includes(t)) s += 6;
      if (d.nDesc.includes(t)) s += 5;
      const i = d.nContent.indexOf(t);
      if (i >= 0) s += Math.max(1, 3 - i / 1500);
    }
    return s;
  }

  function note(title: string, body: string, link?: { href: string; label: string }) {
    const div = document.createElement('div');
    div.className = 'note';
    const strong = document.createElement('strong');
    strong.textContent = title;
    div.append(strong, body);
    if (link) {
      const a = document.createElement('a');
      a.href = link.href;
      a.textContent = link.label;
      div.append(' ', a);
    }
    return div;
  }

  async function render() {
    const query = input.value.trim();
    const terms = [...new Set(normalize(query).split(/\s+/).filter((t) => t.length > 1))];
    if (!terms.length) {
      heading.textContent = 'Type to search every word';
      controls?.setAttribute('hidden', '');
      root.replaceChildren(...idle.map((n) => n.cloneNode(true)));
      history.replaceState(null, '', location.pathname);
      return;
    }
    if (!docs) {
      heading.textContent = 'Opening the index…';
      await load();
    }
    const matches = docs!.filter((d) => terms.every((t) => d.hay.includes(t))).map((d) => ({ d, s: score(d, terms) }));
    const filtered = activeType === 'all' ? matches : matches.filter((m) => m.d.type === activeType);
    const mode = sortSelect.value;
    filtered.sort((a, b) =>
      mode === 'newest' ? b.d.date.localeCompare(a.d.date)
      : mode === 'oldest' ? a.d.date.localeCompare(b.d.date)
      : b.s - a.s || b.d.date.localeCompare(a.d.date));

    controls?.removeAttribute('hidden');
    heading.textContent = `${filtered.length} ${filtered.length === 1 ? 'result' : 'results'}${activeType === 'all' ? '' : ` in ${activeType}`}`;
    history.replaceState(null, '', `${location.pathname}?q=${encodeURIComponent(query)}`);
    root.textContent = '';

    if (!filtered.length) {
      root.append(note('Nothing found.', 'Try fewer words, another spelling, or browse by year in the', { href: '/archive/', label: 'archive →' }));
      return;
    }
    const list = document.createElement('ol');
    list.className = 'results-list';
    for (const { d } of filtered.slice(0, 50)) {
      const li = document.createElement('li');
      li.className = 'result';
      const a = document.createElement('a');
      a.href = d.url;
      const year = document.createElement('span');
      year.className = 'r-year';
      year.textContent = String(d.year);
      const body = document.createElement('span');
      body.className = 'r-body';
      const title = document.createElement('span');
      title.className = 'r-title';
      highlight(title, d.title, terms);
      const ex = document.createElement('p');
      ex.className = 'r-excerpt';
      highlight(ex, excerpt(d, terms), terms);
      const meta = document.createElement('span');
      meta.className = 'r-meta';
      const type = document.createElement('span');
      type.className = 'r-type';
      type.textContent = d.type;
      meta.append(type, d.categories.length ? ` · ${d.categories.join(', ')}` : '');
      body.append(title, ex, meta);
      a.append(year, body);
      li.append(a);
      list.append(li);
    }
    root.append(list);
    if (filtered.length > 50) root.append(note('', `Showing the 50 strongest of ${filtered.length}. Add a word to narrow it.`));
  }

  input.addEventListener('input', () => { clearTimeout(timer); timer = window.setTimeout(render, 90); });
  input.addEventListener('focus', () => { load(); }, { once: true });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && input.value) { e.preventDefault(); input.value = ''; render(); }
    if (e.key === 'ArrowDown') {
      const first = root.querySelector<HTMLElement>('.result a');
      if (first) { e.preventDefault(); first.focus(); }
    }
  });
  root.addEventListener('keydown', (e) => {
    const links = [...root.querySelectorAll<HTMLElement>('.result a')];
    const i = links.indexOf(document.activeElement as HTMLElement);
    if (i < 0) return;
    if (e.key === 'ArrowDown' && links[i + 1]) { e.preventDefault(); links[i + 1].focus(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); (links[i - 1] ?? input).focus(); }
  });
  document.querySelectorAll<HTMLButtonElement>('[data-query]').forEach((b) => b.addEventListener('click', () => {
    input.value = b.dataset.query ?? '';
    input.focus();
    render();
  }));
  typeButtons.forEach((b) => b.addEventListener('click', () => {
    activeType = b.dataset.type ?? 'all';
    typeButtons.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
    render();
  }));
  sortSelect.addEventListener('change', render);

  const initial = new URLSearchParams(location.search).get('q');
  if (initial) { input.value = initial; render(); }
  input.focus({ preventScroll: true });
</script>
