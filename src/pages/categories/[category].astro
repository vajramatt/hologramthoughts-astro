---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostRow from '../../components/PostRow.astro';
import { publishedPosts, themeById, themeIdsFor, themeNamesFor, urlOf } from '../../utils/posts';
import { CATEGORIES } from '../../utils/categories';
import { categoryColor } from '../../utils/category-color';
import { collectionPageGraph } from '../../utils/jsonld';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category: category.slug }, props: { category } }));
}

const { category } = Astro.props;
const posts = (await publishedPosts()).filter((p) => p.data.categories?.includes(category.name));

const themeCounts = new Map<string, number>();
for (const p of posts) for (const id of themeIdsFor(p)) themeCounts.set(id, (themeCounts.get(id) ?? 0) + 1);
const topThreads = [...themeCounts.entries()].sort((a, b) => b[1] - a[1]).slice(0, 8)
  .map(([id, n]) => ({ t: themeById.get(id)!, n })).filter((x) => x.t);

const groups = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.pubDate.getUTCFullYear();
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(p);
}
const years = [...groups.entries()].sort((a, b) => b[0] - a[0]);
const accent = categoryColor(category.name);
const others = CATEGORIES.filter((c) => c.slug !== category.slug);
const SITE = 'https://hologramthoughts.com';
const jsonLd = collectionPageGraph({
  name: `${category.name} — Hologram Thoughts`,
  description: category.description,
  url: `${SITE}/categories/${category.slug}/`,
  posts: posts.map((p) => ({ title: p.data.title, url: `${SITE}${urlOf(p)}` })),
});
---

<Layout wide title={`${category.name} — Hologram Thoughts`} description={`${category.description} ${posts.length} posts by Matthew Williamson.`} jsonLd={jsonLd}>
  <PageHeader
    back={{ href: '/categories/', label: 'all categories' }}
    kicker={`category · ${category.code.toLowerCase()}`}
    title={category.name}
    lede={category.description}
    accent={accent}
    stats={[
      { label: 'posts', value: posts.length },
      { label: 'span', value: posts.length ? `${years.at(-1)![0]}—${years[0][0]}` : '—' },
    ]}
  />

  {topThreads.length > 0 && (
    <section class="threads" aria-labelledby="threads-h">
      <div class="section-label"><h2 id="threads-h">threads that run through it</h2></div>
      <ul>
        {topThreads.map(({ t, n }) => (
          <li><a href={`/themes/${t.id}/`}>{t.name} <b>{n}</b></a></li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="posts-h">
    <h2 id="posts-h" class="visually-hidden">Posts in {category.name}</h2>
    {years.map(([year, list]) => (
      <div class="year-block">
        <h3>{year}</h3>
        <ol>{list.map((p) => <PostRow post={p} themeNames={themeNamesFor(p)} />)}</ol>
      </div>
    ))}
  </section>

  <nav class="others" aria-label="Other categories">
    <div class="section-label"><p>other shelves</p></div>
    <ul>
      {others.map((c) => <li><a href={`/categories/${c.slug}/`} style={`--c:${categoryColor(c.name)}`}>{c.name}</a></li>)}
    </ul>
  </nav>
</Layout>

<style>
  .section-label h2 { font-family: var(--font-mono); font-weight: 500; }
  .threads { margin-bottom: var(--space-l); }
  .threads ul, .others ul { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0; padding: 0; list-style: none; }
  .threads a, .others a {
    display: inline-flex;
    gap: 0.45rem;
    align-items: baseline;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    color: var(--color-ink-soft);
    font: var(--step--1)/1 var(--font-ui);
    text-decoration: none;
  }
  .threads a:hover, .others a:hover { color: var(--color-cyan); border-color: var(--color-cyan); }
  .threads b { color: var(--color-amber-bright); font: 400 var(--step--2) var(--font-mono); }
  .others a::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--c); align-self: center; }
  .year-block { margin-bottom: var(--space-m); }
  .year-block h3 { margin: var(--space-s) 0 0; color: var(--color-blue); font: 500 var(--step-3)/1 var(--font-display); }
  .year-block ol { margin: 0; padding: 0; }
  .others { margin-top: var(--space-xl); }
</style>
