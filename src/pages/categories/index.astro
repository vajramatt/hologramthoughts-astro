---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { publishedPosts, urlOf } from '../../utils/posts';
import { CATEGORIES } from '../../utils/categories';
import { categoryColor } from '../../utils/category-color';

const posts = await publishedPosts();
const cats = CATEGORIES.map((c) => {
  const list = posts.filter((p) => p.data.categories?.includes(c.name));
  return {
    ...c,
    count: list.length,
    latest: list.slice(0, 3),
    first: list.at(-1)?.data.pubDate.getUTCFullYear(),
    last: list[0]?.data.pubDate.getUTCFullYear(),
    color: categoryColor(c.name),
  };
}).filter((c) => c.count > 0);
---

<Layout wide title="Categories — Hologram Thoughts" description="Browse Hologram Thoughts by kind of writing: dharma writings, creative work, consciousness and philosophy, practice and inner life, and everything else.">
  <PageHeader kicker="categories" stats={[{ label: 'posts', value: posts.length }, { label: 'shelves', value: cats.length }]}>
    <Fragment slot="title">Five shelves, <em>one archive.</em></Fragment>
    <Fragment slot="lede">The broad shelves — a place to begin when you know the kind of writing you want. For subtler connections, follow the <a href="/themes/">threads</a>.</Fragment>
  </PageHeader>

  <ol class="shelves">
    {cats.map((c) => (
      <li style={`--c:${c.color}`}>
        <a class="shelf-head" href={`/categories/${c.slug}/`}>
          <span class="sh-top"><span class="sh-code">{c.code}</span><span class="sh-years">{c.first}—{c.last}</span></span>
          <h2>{c.name}</h2>
          <p>{c.description}</p>
          <span class="sh-count"><b>{c.count}</b> posts <span aria-hidden="true">→</span></span>
        </a>
        <ul class="sh-latest" aria-label={`Latest in ${c.name}`}>
          {c.latest.map((p) => (
            <li><a href={urlOf(p)}><span>{p.data.title}</span><time datetime={p.data.pubDate.toISOString()}>{p.data.pubDate.getUTCFullYear()}</time></a></li>
          ))}
        </ul>
      </li>
    ))}
  </ol>
</Layout>

<style>
  .shelves { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: var(--space-xs); margin: 0; padding: 0; list-style: none; }
  .shelves > li {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--c);
    border-radius: 12px;
    background: color-mix(in oklch, var(--color-surface) 40%, transparent);
    overflow: hidden;
  }
  .shelves > li { grid-column: span 2; }
  /* 5 shelves: 3 across, then 2 wider — no empty cell. */
  .shelves > li:nth-child(n + 4):nth-last-child(-n + 2) { grid-column: span 3; }
  .shelf-head {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--space-s);
    color: var(--color-ink);
    text-decoration: none;
  }
  .shelf-head:hover h2 { color: var(--c); }
  .sh-top { display: flex; justify-content: space-between; font: var(--step--2)/1 var(--font-mono); }
  .sh-code { color: var(--c); letter-spacing: 0.12em; }
  .sh-years { color: var(--color-ink-faint); }
  h2 { margin: 0; font-size: var(--step-2); font-weight: 480; transition: color var(--dur-fast); }
  p { margin: 0; color: var(--color-ink-soft); font-size: var(--step--1); line-height: 1.5; }
  .sh-count { color: var(--color-ink-faint); font: var(--step--2) var(--font-mono); }
  .sh-count b { color: var(--color-amber-bright); font-weight: 400; }
  .sh-latest { margin: auto 0 0; padding: 0 var(--space-s) var(--space-xs); list-style: none; }
  .sh-latest a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-ink-soft);
    font: var(--step--1)/1.35 var(--font-display);
    text-decoration: none;
  }
  .sh-latest a:hover { color: var(--color-cyan); }
  .sh-latest time { color: var(--color-amber-bright); font: var(--step--2) var(--font-mono); }
  @media (max-width: 960px) { .shelves { grid-template-columns: repeat(2, minmax(0, 1fr)); } .shelves > li, .shelves > li:nth-child(n + 4):nth-last-child(-n + 2) { grid-column: auto; } .shelves > li:last-child:nth-child(odd) { grid-column: 1 / -1; } }
  @media (max-width: 600px) { .shelves { grid-template-columns: 1fr; } }
</style>
